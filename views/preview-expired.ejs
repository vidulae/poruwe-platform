<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/public/icons/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
<title>Preview expired · Poruwe</title>
<meta name="robots" content="noindex" />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Italiana&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/public/poruwe.css?v=2" />
</head>
<body style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px">
  <div style="width:74px;height:74px;border-radius:50%;border:1.5px solid var(--gold);display:flex;align-items:center;justify-content:center;margin-bottom:24px">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#8F6E2A" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3" stroke-linecap="round"/></svg>
  </div>
  <p class="eyebrow">Order <%= order.order_no %></p>
  <h1 style="font-size:clamp(1.9rem,6vw,2.8rem);margin:14px 0 12px">This preview has expired</h1>
  <p style="max-width:460px;margin-bottom:34px;font-family:var(--serif);font-size:1.12rem">Previews stay live for <%= ttlHours %> hours after your last edit. Everything you built is safely saved — open the builder to refresh it, or complete payment to publish your invitation for good.</p>
  <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
    <a class="btn btn-gold" href="/b/<%= order.token %>">Continue &amp; publish</a>
    <a class="btn btn-ghost" href="/status/<%= order.token %>">Order status</a>
  </div>
  <p style="font-family:var(--script);font-size:1.5rem;color:var(--gold-deep);margin-top:44px">Poruwe</p>
</body>
</html>
