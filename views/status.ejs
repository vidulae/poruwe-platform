<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/public/icons/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
<title>Order <%= order.order_no %> · Poruwe</title>
<meta name="robots" content="noindex" />
<% if (['draft','pending_payment','pending_verification'].includes(order.status)) { %><meta http-equiv="refresh" content="25" /><% } %>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Italiana&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/public/poruwe.css?v=2" />
<style>
  .swrap{max-width:680px;margin:0 auto;padding:44px 18px 90px;text-align:center}
  .badge{display:inline-block;font-family:var(--sans);font-size:.74rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;padding:9px 20px;border-radius:24px;margin-bottom:20px}
  .b-draft{background:#EDE5D2;color:#7A5B1E}
  .b-pending{background:#F0E6CF;color:#7A5B1E}
  .b-active{background:var(--grad-gold);color:var(--forest-2)}
  .b-bad{background:#EBDCD8;color:#8A3E30}
  .swrap h1{font-size:clamp(2rem,7vw,2.5rem);margin-bottom:10px}
  .swrap .sub{font-family:var(--serif);font-size:1.15rem;color:var(--body);margin-bottom:32px}
  .flow{display:flex;justify-content:center;gap:0;margin-bottom:38px}
  .fstep{flex:1;max-width:150px;position:relative;font-family:var(--sans);font-size:.68rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:26px 4px 0}
  .fstep::before{content:'';position:absolute;top:7px;left:50%;transform:translateX(-50%);width:13px;height:13px;border-radius:50%;background:var(--cream);border:2px solid rgba(198,161,79,.45)}
  .fstep::after{content:'';position:absolute;top:13px;left:calc(50% + 11px);right:calc(-50% + 11px);height:2px;background:rgba(198,161,79,.3)}
  .fstep:last-child::after{display:none}
  .fstep.done::before{background:var(--gold);border-color:var(--gold)}
  .fstep.done{color:var(--gold-deep);font-weight:600}
  @media(max-width:460px){.fstep{font-size:.6rem;letter-spacing:.04em}}
  .linkbox{background:var(--forest);color:var(--cream);border-radius:14px;padding:clamp(26px,5vw,36px) clamp(18px,4vw,28px);margin-bottom:26px;box-shadow:var(--shadow)}
  .linkbox .lu{font-family:var(--sans);font-size:clamp(.92rem,3vw,1.05rem);font-weight:500;color:var(--gold-light);word-break:break-all;margin:14px 0 22px;display:block}
  .actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:14px}
  @media(max-width:520px){.actions .btn{flex:1 1 100%}}
  .note{font-family:var(--serif);font-size:1.02rem;font-style:italic;color:var(--body)}
  .panelbox{background:var(--ivory);border:1px solid var(--line);border-radius:14px;padding:clamp(22px,5vw,30px);margin-bottom:26px;text-align:left;box-shadow:var(--shadow-sm)}
  .panelbox h3{font-size:1.5rem;margin-bottom:10px}
  .panelbox p{font-size:1rem}
  .bankline{display:flex;justify-content:space-between;gap:12px;padding:7px 0;font-size:.95rem;flex-wrap:wrap}
  .bankline span{font-family:var(--sans);font-size:.72rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);padding-top:3px}
  .bankline b{color:var(--ink);font-family:var(--sans);font-weight:600}
</style>
</head>
<body>
<nav class="pnav"><a class="wordmark" href="/">Poruwe</a><div class="links"><a href="/receipt/<%= order.token %>">Receipt</a></div></nav>
<div class="swrap">
  <%
    const st = order.status;
    const badge = st === 'active' ? ['b-active','Live'] : st === 'draft' ? ['b-draft','Draft'] :
      st === 'pending_payment' ? ['b-pending','Awaiting payment'] : st === 'pending_verification' ? ['b-pending','Verifying payment'] :
      st === 'rejected' ? ['b-bad','Needs attention'] : ['b-bad', st.charAt(0).toUpperCase()+st.slice(1)];
    const flowIdx = st === 'draft' ? 0 : (st === 'pending_payment' || st === 'pending_verification') ? 1 : st === 'active' ? 3 : 2;
  %>
  <span class="badge <%= badge[0] %>"><%= badge[1] %></span>
  <h1>Order <%= order.order_no %></h1>
  <p class="sub"><%= tpl.name %> · <%= formatLKR(tpl.price_lkr) %></p>

  <div class="flow">
    <div class="fstep done">Details</div>
    <div class="fstep <%= flowIdx >= 1 ? 'done' : '' %>">Payment</div>
    <div class="fstep <%= flowIdx >= 2 ? 'done' : '' %>">Verification</div>
    <div class="fstep <%= flowIdx >= 3 ? 'done' : '' %>">Live</div>
  </div>

  <% if (st === 'active') { %>
    <div class="linkbox">
      <span class="eyebrow" style="color:var(--gold-light)">🎉 Your invitation is live</span>
      <% if (order.kind === 'website' && liveUrl) { %>
        <a class="lu" href="<%= liveUrl %>" target="_blank" rel="noopener"><%= liveUrl %></a>
        <div class="actions">
          <button class="btn btn-gold" onclick="navigator.clipboard.writeText('<%= liveUrl %>').then(()=>this.textContent='Copied ✓')">Copy link</button>
          <a class="btn btn-line" style="border-color:var(--gold-light);color:var(--gold-light)" href="https://wa.me/?text=<%= encodeURIComponent('You are warmly invited! 💍 ' + liveUrl) %>" target="_blank" rel="noopener">Share on WhatsApp</a>
          <a class="btn btn-line" style="border-color:var(--gold-light);color:var(--gold-light)" href="/b/<%= order.token %>">Edit invitation</a>
        </div>
      <% } else if (order.kind === 'pdf') { %>
        <p style="margin-bottom:18px">Your printable invitation is ready.</p>
        <div class="actions"><a class="btn btn-gold" href="/d/<%= order.token %>/invitation.pdf">Download PDF</a></div>
      <% } else { %>
        <p style="margin-bottom:18px">Your invitation image is ready.</p>
        <div class="actions"><a class="btn btn-gold" href="/d/<%= order.token %>/card.png">Download image</a></div>
      <% } %>
      <% if (order.kind !== 'website') { %>
        <div class="actions"><a class="btn btn-line" style="border-color:var(--gold-light);color:var(--gold-light)" href="/b/<%= order.token %>">Edit & regenerate</a></div>
      <% } %>
    </div>
    <p class="note">Live until 3 days after your wedding — then all data is automatically and permanently deleted.</p>
  <% } else if (st === 'pending_verification') { %>
    <%
      const pay = order.payment || {};
      const hasProof = !!(pay.reference || pay.slipImage);
      const hasBank = bank && bank.accountNumber;
    %>
    <div class="panelbox">
      <h3><%= hasProof ? "We're verifying your payment" : 'Order received — payment is the last step' %></h3>
      <% if (hasProof) { %>
        <p>This usually takes a few hours at most. This page refreshes automatically — your link appears here the moment it's approved. You can keep polishing your invitation in the meantime.</p>
      <% } else { %>
        <p style="margin-bottom:14px">Your invitation is ready and waiting. To take it live:</p>
        <ol style="margin:0 0 6px 20px;font-size:1rem;display:flex;flex-direction:column;gap:8px">
          <li>Transfer <b><%= formatLKR(tpl.price_lkr) %></b><%= hasBank ? ' to the account below' : ' — we\'ll send the bank details on WhatsApp' %></li>
          <li>Send us the slip on WhatsApp, or attach it to your order</li>
          <li>We verify and your invitation goes live — you'll see it right here</li>
        </ol>
      <% } %>
      <% if (hasBank) { %>
        <div style="border-top:1px dashed rgba(198,161,79,.4);margin-top:16px;padding-top:14px">
          <div class="bankline"><span>Account name</span><b><%= bank.accountName %></b></div>
          <div class="bankline"><span>Bank</span><b><%= bank.bank %></b></div>
          <div class="bankline"><span>Branch</span><b><%= bank.branch %></b></div>
          <div class="bankline"><span>Account number</span><b><%= bank.accountNumber %></b></div>
        </div>
      <% } %>
    </div>
    <div class="actions">
      <% if (support) { %>
        <a class="btn btn-gold" href="https://wa.me/<%= support %>?text=<%= encodeURIComponent('Hi! This is about my Poruwe order ' + order.order_no + ' (' + tpl.name + ', ' + formatLKR(tpl.price_lkr) + ').' + (hasProof ? ' Just checking on the verification status.' : ' Please send me the bank transfer details — I\'ll send the payment slip here once I\'ve transferred.') + ' My order page: ' + statusUrl) %>" target="_blank" rel="noopener"><%= hasProof ? 'Message us on WhatsApp' : (hasBank ? 'Send my slip on WhatsApp' : 'Get bank details on WhatsApp') %></a>
      <% } %>
      <a class="btn btn-line" href="/b/<%= order.token %>"><%= hasProof ? 'Keep editing' : 'Add slip / reference to my order' %></a>
    </div>
  <% } else if (st === 'pending_payment') { %>
    <div class="panelbox"><h3>Payment not completed yet</h3>
      <p>It looks like the online payment wasn't finished. You can return to the builder and try again.</p></div>
    <div class="actions"><a class="btn btn-gold" href="/b/<%= order.token %>">Back to builder</a></div>
  <% } else if (st === 'draft') { %>
    <div class="panelbox"><h3>Your invitation is still a draft</h3><p>Pick up where you left off — your work is saved.</p></div>
    <div class="actions"><a class="btn btn-gold" href="/b/<%= order.token %>">Continue building</a></div>
  <% } else if (st === 'rejected') { %>
    <div class="panelbox"><h3>We couldn't verify this payment</h3>
      <p><%= (order.payment && order.payment.rejectReason) || 'Please contact us and we\'ll sort it out quickly.' %></p></div>
    <div class="actions"><a class="btn btn-gold" href="/b/<%= order.token %>">Update & resubmit</a></div>
  <% } else { %>
    <div class="panelbox"><h3>This invitation has concluded</h3><p>All personal data has been permanently removed, as promised.</p></div>
  <% } %>

  <% if (!['expired','revoked'].includes(order.status)) { %>
  <div class="panelbox" style="text-align:center;border-color:var(--gold);background:rgba(198,161,79,.07)">
    <h3 style="font-size:1.3rem">Keep this page safe</h3>
    <p style="font-size:.98rem;margin-bottom:16px">This link is your key to your order — the live invitation, downloads and receipt all live here. Save it before you close this window.</p>
    <div class="actions" style="margin-bottom:0">
      <button class="btn btn-gold" id="copyStatus">Copy my link</button>
      <a class="btn btn-line" href="https://wa.me/?text=<%= encodeURIComponent('My Poruwe wedding invitation — order ' + order.order_no + '. Status, link & receipt: ' + statusUrl) %>" target="_blank" rel="noopener">Save to WhatsApp</a>
    </div>
    <p class="hint" style="margin-top:12px">Tip: “Save to WhatsApp” lets you send it to yourself or your partner — it'll always be in your chats.</p>
  </div>
  <% } %>

  <div class="actions" style="margin-top:26px">
    <a class="btn btn-ghost" href="/receipt/<%= order.token %>">View receipt</a>
    <a class="btn btn-ghost" href="/receipt/<%= order.token %>.pdf">Receipt PDF</a>
    <% if (support) { %><a class="btn btn-ghost" href="https://wa.me/<%= support %>" target="_blank" rel="noopener">WhatsApp support</a><% } %>
  </div>
</div>
<script>
  document.getElementById('copyStatus') && (document.getElementById('copyStatus').onclick = function () {
    navigator.clipboard.writeText('<%= statusUrl %>').then(() => { this.textContent = 'Copied ✓'; });
  });
  // Remember this order on this device so the landing page can bring the user back
  try {
    var K = 'poruwe_orders';
    var list = JSON.parse(localStorage.getItem(K) || '[]').filter(function (o) { return o.t !== '<%= order.token %>'; });
    list.unshift({ t: '<%= order.token %>', no: '<%= order.order_no %>', tpl: '<%= tpl.name %>', st: '<%= order.status %>', at: Date.now() });
    localStorage.setItem(K, JSON.stringify(list.slice(0, 5)));
  } catch (e) {}
</script>
</body>
</html>
