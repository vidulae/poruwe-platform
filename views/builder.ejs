<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Build your invitation · Poruwe</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Italiana&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/public/poruwe.css" />
<style>
  body{background:var(--cream)}
  .bwrap{max-width:880px;margin:0 auto;padding:32px 20px 90px}
  .bhead{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:26px;flex-wrap:wrap}
  .bhead .tpl{font-family:var(--sans);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
  .bhead .tpl b{color:var(--gold-deep)}
  .progress{display:flex;gap:6px;margin-bottom:34px;flex-wrap:wrap}
  .pstep{flex:1;min-width:64px;text-align:center;font-family:var(--sans);font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);padding-top:10px;border-top:2px solid rgba(200,162,75,.25);cursor:pointer;transition:.3s}
  .pstep.done{border-top-color:var(--gold);color:var(--gold-deep)}
  .pstep.cur{border-top-color:var(--forest);color:var(--ink);font-weight:600}
  .step-panel{display:none;background:var(--ivory);border:1px solid var(--border);border-radius:8px;padding:38px 34px;box-shadow:var(--shadow)}
  .step-panel.cur{display:block;animation:fadeUp .5s var(--ease-out)}
  @keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1}}
  .step-panel h2{font-size:1.9rem;margin-bottom:6px}
  .step-panel .sub{margin-bottom:28px;font-style:italic}
  .bnav{display:flex;justify-content:space-between;gap:12px;margin-top:30px}
  .rowitem{border:1px solid var(--border);border-radius:6px;padding:18px;margin-bottom:14px;background:var(--cream);position:relative}
  .rowitem .rm{position:absolute;top:10px;right:12px;background:none;border:none;color:var(--muted);cursor:pointer;font-family:var(--sans);font-size:.65rem;letter-spacing:.12em;text-transform:uppercase}
  .rowitem .rm:hover{color:#a33}
  .addrow{width:100%;border:1.5px dashed var(--border);background:none;border-radius:6px;padding:13px;font-family:var(--sans);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-deep);cursor:pointer}
  .addrow:hover{border-color:var(--gold)}
  .photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:18px}
  .photo-slot{border:1.5px dashed var(--border);border-radius:8px;padding:16px;text-align:center;cursor:pointer;transition:.3s;background:var(--cream)}
  .photo-slot:hover{border-color:var(--gold)}
  .photo-slot img{width:100%;height:130px;object-fit:cover;border-radius:5px;margin-bottom:10px}
  .photo-slot .ph-empty{height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--muted)}
  .photo-slot .lbl{font-family:var(--sans);font-size:.64rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-deep);font-weight:600}
  .summary{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px;margin-bottom:26px}
  .summary .k{font-family:var(--sans);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
  .summary .v{color:var(--ink);font-size:1.1rem;margin-bottom:10px}
  .paybox{border:1px solid var(--border);border-radius:8px;padding:24px;margin-top:18px;background:var(--cream)}
  .paybox h4{font-family:var(--sans);font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-deep);margin-bottom:14px}
  .bankrow{display:flex;justify-content:space-between;gap:14px;padding:7px 0;border-bottom:1px dashed rgba(200,162,75,.25);font-size:1rem}
  .bankrow b{color:var(--ink);font-weight:500}
  .price-line{display:flex;justify-content:space-between;align-items:center;font-family:var(--sans);margin-bottom:14px}
  .price-line .amt{font-size:1.5rem;font-weight:600;color:var(--ink)}
  .method-tabs{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap}
  .mtab{flex:1;min-width:140px;border:1.5px solid var(--border);background:var(--ivory);border-radius:6px;padding:14px;text-align:center;cursor:pointer;font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .mtab.sel{border-color:var(--gold);color:var(--ink);background:#fff;font-weight:600}
  .savebar{position:fixed;bottom:0;left:0;right:0;background:rgba(246,243,237,.94);backdrop-filter:blur(10px);border-top:1px solid var(--border);padding:11px 20px;display:flex;justify-content:space-between;align-items:center;z-index:40}
  .savebar .st{font-family:var(--sans);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
</style>
</head>
<body>

<nav class="pnav">
  <a class="wordmark" href="/">Poruwe</a>
  <div class="links"><a href="/status/<%= order.token %>">Order <%= order.order_no %></a></div>
</nav>

<div class="bwrap">
  <div class="bhead">
    <div>
      <span class="eyebrow">Invitation builder</span>
      <h1 style="font-size:2.1rem">Let's craft your invitation</h1>
    </div>
    <div class="tpl">Template<br><b><%= tpl.name %></b> · <%= formatLKR(tpl.price_lkr) %></div>
  </div>

  <div class="progress" id="progress"></div>
  <div id="steps"></div>

  <div class="bnav">
    <button class="btn btn-ghost" id="backBtn">← Back</button>
    <div style="display:flex;gap:10px">
      <button class="btn btn-line" id="previewBtn">Preview</button>
      <button class="btn btn-gold" id="nextBtn">Continue →</button>
    </div>
  </div>
</div>

<div class="savebar"><span class="st" id="saveState">Draft saved automatically</span><span class="st">Order <b style="color:var(--gold-deep)"><%= order.order_no %></b></span></div>
<div id="toast"></div>

<script>
  window.ORDER = <%- JSON.stringify({ token: order.token, orderNo: order.order_no, kind: order.kind, status: order.status, data: order.data }) %>;
  window.TPL = <%- JSON.stringify({ id: tpl.id, name: tpl.name, kind: tpl.kind, price: tpl.price_lkr, priceDisplay: formatLKR(tpl.price_lkr) }) %>;
</script>
<script src="/public/builder.js"></script>
</body>
</html>
