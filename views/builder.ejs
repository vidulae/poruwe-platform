<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Build your invitation · Poruwe</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Italiana&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/public/poruwe.css?v=2" />
<style>
  body{background:var(--cream)}
  .bwrap{max-width:880px;margin:0 auto;padding:28px 18px 110px}
  .bhead{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:24px;flex-wrap:wrap}
  .bhead h1{font-size:clamp(1.7rem,5.4vw,2.2rem)}
  .bhead .tpl{font-family:var(--sans);font-size:.74rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .bhead .tpl b{color:var(--gold-deep)}
  .progress{display:flex;gap:8px;margin-bottom:28px;overflow-x:auto;padding-bottom:6px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .progress::-webkit-scrollbar{display:none}
  .pstep{flex:0 0 auto;font-family:var(--sans);font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:9px 16px;border:1.5px solid var(--line);border-radius:24px;cursor:pointer;transition:.3s;background:var(--ivory);white-space:nowrap}
  .pstep.done{border-color:var(--gold);color:var(--gold-deep);background:rgba(198,161,79,.1)}
  .pstep.cur{border-color:var(--forest);color:var(--cream);background:var(--forest)}
  .step-panel{display:none;background:var(--ivory);border:1px solid var(--line);border-radius:14px;padding:clamp(24px,5vw,38px);box-shadow:var(--shadow-sm)}
  .step-panel.cur{display:block;animation:fadeUp .5s var(--ease-out)}
  @keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1}}
  .step-panel h2{font-size:clamp(1.6rem,5vw,2rem);margin-bottom:6px}
  .step-panel .sub{font-family:var(--serif);font-size:1.12rem;font-style:italic;color:var(--body);margin-bottom:26px}
  .bnav{display:flex;justify-content:space-between;gap:10px;margin-top:26px;flex-wrap:wrap}
  .bnav > div{display:flex;gap:10px;flex-wrap:wrap}
  @media(max-width:560px){
    .bnav,.bnav > div{flex-direction:column;align-items:stretch}
    .bnav .btn{width:100%}
  }
  .rowitem{border:1px solid var(--line);border-radius:10px;padding:18px;margin-bottom:14px;background:var(--cream);position:relative}
  .rowitem .rm{position:absolute;top:12px;right:14px;background:none;border:none;color:var(--muted);cursor:pointer;font-family:var(--sans);font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}
  .rowitem .rm:hover{color:#A0392C}
  .addrow{width:100%;border:1.5px dashed var(--line);background:none;border-radius:10px;padding:14px;font-family:var(--sans);font-size:.76rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-deep);cursor:pointer;transition:.3s}
  .addrow:hover{border-color:var(--gold);background:rgba(198,161,79,.06)}
  .photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(180px,100%),1fr));gap:16px}
  .photo-slot{border:1.5px dashed var(--line);border-radius:12px;padding:16px;text-align:center;cursor:pointer;transition:.3s;background:var(--cream)}
  .photo-slot:hover{border-color:var(--gold);background:rgba(198,161,79,.05)}
  .photo-slot img{width:100%;height:132px;object-fit:cover;border-radius:8px;margin-bottom:10px}
  .photo-slot .ph-empty{height:132px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--muted);font-size:.9rem}
  .photo-slot .lbl{font-family:var(--sans);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-deep);font-weight:600}
  .summary{display:grid;grid-template-columns:1fr 1fr;gap:6px 22px;margin-bottom:24px}
  @media(max-width:520px){.summary{grid-template-columns:1fr}}
  .summary .k{font-family:var(--sans);font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .summary .v{font-family:var(--serif);color:var(--ink);font-size:1.2rem;margin-bottom:10px}
  .paybox{border:1px solid var(--line);border-radius:12px;padding:clamp(18px,4vw,26px);margin-top:16px;background:var(--cream)}
  .paybox h4{font-family:var(--sans);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-deep);margin-bottom:14px}
  .paybox p{font-size:.95rem}
  .bankrow{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px dashed rgba(198,161,79,.3);font-size:.95rem;flex-wrap:wrap}
  .bankrow b{color:var(--ink);font-weight:600;font-family:var(--sans);font-size:.95rem}
  .price-line{display:flex;justify-content:space-between;align-items:center;font-family:var(--sans);margin-bottom:16px}
  .price-line .lbl-t{font-size:.72rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
  .price-line .amt{font-size:1.65rem;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums}
  .method-tabs{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap}
  .mtab{flex:1;min-width:min(150px,100%);border:1.5px solid var(--line);background:var(--ivory);border-radius:10px;padding:14px;text-align:center;cursor:pointer;font-family:var(--sans);font-size:.76rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);transition:.3s}
  .mtab.sel{border-color:var(--gold);color:var(--ink);background:#fff;font-weight:600;box-shadow:0 0 0 3px rgba(198,161,79,.15)}
  .savebar{position:fixed;bottom:0;left:0;right:0;background:rgba(247,244,238,.95);backdrop-filter:blur(12px);border-top:1px solid var(--line);padding:12px 18px;display:flex;justify-content:space-between;align-items:center;gap:10px;z-index:40}
  .savebar .st{font-family:var(--sans);font-size:.72rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
</style>
</head>
<body>

<nav class="pnav">
  <a class="wordmark" href="/">Poruwe</a>
  <div class="links"><a href="/status/<%= order.token %>">Order <%= order.order_no %></a></div>
</nav>

<div class="bwrap">
  <div class="bhead">
    <div>
      <span class="eyebrow">Invitation builder</span>
      <h1>Let's craft your invitation</h1>
    </div>
    <div class="tpl">Template<br><b><%= tpl.name %></b> · <%= formatLKR(tpl.price_lkr) %></div>
  </div>

  <div class="progress" id="progress"></div>
  <div id="steps"></div>

  <div class="bnav">
    <button class="btn btn-ghost" id="backBtn">← Back</button>
    <div style="display:flex;gap:10px">
      <button class="btn btn-line" id="previewBtn">Preview</button>
      <button class="btn btn-gold" id="nextBtn">Continue →</button>
    </div>
  </div>
</div>

<div class="savebar"><span class="st" id="saveState">Draft saved automatically</span><span class="st">Order <b style="color:var(--gold-deep)"><%= order.order_no %></b></span></div>
<div id="toast"></div>

<script>
  window.ORDER = <%- JSON.stringify({ token: order.token, orderNo: order.order_no, kind: order.kind, status: order.status, data: order.data }) %>;
  window.TPL = <%- JSON.stringify({ id: tpl.id, name: tpl.name, kind: tpl.kind, price: tpl.price_lkr, priceDisplay: formatLKR(tpl.price_lkr) }) %>;
</script>
<script src="/public/builder.js?v=2"></script>
</body>
</html>
