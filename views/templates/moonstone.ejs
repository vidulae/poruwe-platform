<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/public/icons/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
<title><%= s.coupleTitle %> · <%= s.dateShort %></title>
<meta name="robots" content="noindex" />
<meta name="description" content="<%= s.coupleTitle %> — <%= s.dateLong %> · <%= s.venueName %>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Italiana&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root{
    --bone:#FAFAF7; --ink:#141412; --grey:#73736C; --hair:#E2E2DB;
    --moon:#7F93A8; --moon-deep:#5E7288;
    --display:'Italiana',serif; --serif:'Cormorant Garamond',Georgia,serif; --sans:'Montserrat',sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--bone);color:var(--ink);font-family:var(--serif);font-size:1.12rem;line-height:1.85;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  img{max-width:100%;display:block}
  .k{font-family:var(--sans);font-size:.62rem;font-weight:600;letter-spacing:.44em;text-transform:uppercase;color:var(--grey)}
  .k.moon{color:var(--moon-deep)}
  .wrap{max-width:1140px;margin:0 auto;padding:0 clamp(20px,5vw,56px)}
  .rv{opacity:0;transform:translateY(26px);transition:opacity 1.1s cubic-bezier(.16,1,.3,1),transform 1.1s cubic-bezier(.16,1,.3,1)}
  .rv.in{opacity:1;transform:none}
  .rule{border:0;border-top:1px solid var(--hair)}

  /* masthead */
  .mast{min-height:100svh;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(22px,4vw,44px)}
  .mtop{display:flex;justify-content:space-between;align-items:baseline;gap:14px}
  .mtop .k{color:var(--ink)}
  .mmid{text-align:left}
  .mname{font-family:var(--display);font-weight:400;font-size:clamp(3.4rem,15vw,11.5rem);line-height:.98;letter-spacing:.015em;text-transform:uppercase;opacity:0;transform:translateY(30px);animation:up 1.5s cubic-bezier(.16,1,.3,1) forwards}
  .mname.b{text-align:right;animation-delay:.4s}
  .mamp{display:flex;align-items:center;gap:26px;margin:clamp(4px,1.4vw,18px) 0;opacity:0;animation:fade 1.4s .85s forwards}
  .mamp .ln{flex:1;height:1px;background:var(--ink)}
  .mamp em{font-family:var(--serif);font-style:italic;font-weight:300;font-size:clamp(1.4rem,4vw,2.4rem);color:var(--moon-deep)}
  .mbot{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;opacity:0;animation:fade 1.6s 1.3s forwards}
  .mbot .k{max-width:46ch;line-height:2}
  @keyframes up{to{opacity:1;transform:none}}
  @keyframes fade{to{opacity:1}}

  /* statement */
  .stmt{padding:clamp(100px,16vh,170px) 0}
  .stmt p{font-weight:300;font-size:clamp(1.7rem,4.6vw,3rem);line-height:1.5;max-width:26ch}
  .stmt p em{font-style:italic;color:var(--moon-deep)}
  .stmt .k{display:block;margin-bottom:30px}

  /* countdown strip */
  .cstrip{border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);display:grid;grid-template-columns:repeat(4,1fr)}
  .cu{padding:clamp(22px,4vw,40px) 10px;text-align:center;border-left:1px solid var(--hair)}
  .cu:first-child{border-left:0}
  .cu b{display:block;font-family:var(--display);font-weight:400;font-size:clamp(2rem,7vw,4.4rem);line-height:1;font-variant-numeric:tabular-nums}
  .cu span{font-family:var(--sans);font-size:.56rem;font-weight:600;letter-spacing:.34em;text-transform:uppercase;color:var(--grey)}

  /* chapters */
  .chapters{padding:clamp(100px,15vh,160px) 0 40px}
  .chead{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:clamp(50px,8vw,90px)}
  .chead h2{font-family:var(--display);font-weight:400;font-size:clamp(2.2rem,7vw,4rem);text-transform:uppercase;letter-spacing:.03em}
  .chp{display:grid;grid-template-columns:minmax(80px,180px) 1fr;gap:clamp(18px,4vw,60px);padding:clamp(34px,6vw,56px) 0;border-top:1px solid var(--hair)}
  .chp:last-child{border-bottom:1px solid var(--hair)}
  .chp .no{font-family:var(--display);font-size:clamp(1.3rem,3vw,1.9rem);color:var(--moon)}
  .chp h3{font-weight:400;font-style:italic;font-size:clamp(1.6rem,4vw,2.3rem);margin-bottom:12px}
  .chp .lbl{display:block;margin-bottom:10px}
  .chp p{color:#3C3C36;max-width:58ch;font-weight:300}

  /* portraits */
  .duo{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,4vw,44px);max-width:760px;margin:clamp(60px,9vw,100px) auto 0}
  .duo figure{text-align:left}
  .duo .frame{border:1px solid var(--ink);padding:10px}
  .duo img{width:100%;aspect-ratio:.84;object-fit:cover;filter:grayscale(1) contrast(1.05)}
  .duo figcaption{margin-top:14px;display:flex;justify-content:space-between;align-items:baseline;gap:10px}
  .duo .nm{font-family:var(--display);font-size:1.3rem;text-transform:uppercase;letter-spacing:.06em}
  .duo .rl{font-family:var(--sans);font-size:.56rem;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--moon-deep)}

  /* schedule */
  .sched{padding:clamp(100px,15vh,160px) 0 20px}
  .srow{display:grid;grid-template-columns:minmax(90px,200px) 1fr;gap:clamp(18px,4vw,60px);align-items:baseline;padding:22px 0;border-top:1px solid var(--hair)}
  .srow:last-of-type{border-bottom:1px solid var(--hair)}
  .srow time{font-family:var(--sans);font-size:.76rem;font-weight:600;letter-spacing:.26em;color:var(--moon-deep)}
  .srow h4{font-weight:400;font-size:clamp(1.3rem,3.4vw,1.8rem);display:inline}
  .srow p{display:inline;color:var(--grey);font-size:1.02rem;font-weight:300}
  .srow p::before{content:' — '}

  /* venue */
  .ven{padding:clamp(100px,15vh,160px) 0}
  .vgrid{display:grid;grid-template-columns:1.25fr 1fr;gap:clamp(26px,5vw,70px);align-items:end}
  .vgrid img{width:100%;height:clamp(300px,52vh,560px);object-fit:cover;filter:grayscale(.5) contrast(1.02)}
  .vinfo h3{font-family:var(--display);font-weight:400;font-size:clamp(2rem,5.6vw,3.4rem);line-height:1.1;text-transform:uppercase;margin:16px 0 14px}
  .vinfo p{color:var(--grey);font-weight:300;max-width:38ch}
  .vfacts{margin:28px 0 34px}
  .vfacts div{display:flex;justify-content:space-between;gap:14px;padding:12px 0;border-top:1px solid var(--hair);font-size:1rem}
  .vfacts div:last-child{border-bottom:1px solid var(--hair)}
  .vfacts span{font-family:var(--sans);font-size:.6rem;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--grey);padding-top:5px}
  .vfacts b{font-weight:500}
  .btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 34px;background:var(--ink);color:var(--bone);font-family:var(--sans);font-size:.7rem;font-weight:600;letter-spacing:.28em;text-transform:uppercase;text-decoration:none;border:1px solid var(--ink);cursor:pointer;transition:.35s}
  .btn:hover{background:var(--moon-deep);border-color:var(--moon-deep)}
  .btn.ghost{background:none;color:var(--ink)}
  .btn.ghost:hover{background:var(--ink);color:var(--bone)}

  /* rsvp */
  .reply{padding:clamp(100px,15vh,160px) 0 clamp(90px,13vh,150px);background:var(--ink);color:var(--bone)}
  .reply .k{color:var(--moon)}
  .reply h2{font-family:var(--display);font-weight:400;font-size:clamp(2.2rem,8vw,4.6rem);text-transform:uppercase;letter-spacing:.03em;margin:14px 0 46px}
  .rgrid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,6vw,80px)}
  .rleft p{color:#B9B9B0;font-weight:300;max-width:40ch}
  .who{margin-top:34px}
  .who > div{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 0;border-top:1px solid #33332E}
  .who .nm{font-size:1.25rem;font-weight:400}
  .who .rl{display:block;font-family:var(--sans);font-size:.56rem;letter-spacing:.3em;text-transform:uppercase;color:#8A8A82;margin-top:2px}
  .who a{color:var(--moon);text-decoration:none;font-family:var(--sans);font-size:.66rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;border-bottom:1px solid transparent;transition:.3s}
  .who a:hover{border-color:var(--moon)}
  .f{margin-bottom:18px}
  .f label{display:block;font-family:var(--sans);font-size:.6rem;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:#8A8A82;margin-bottom:9px}
  .f input,.f select,.f textarea{width:100%;background:none;border:0;border-bottom:1px solid #45453E;padding:10px 2px;font-family:var(--serif);font-size:1.15rem;font-weight:300;color:var(--bone);outline:none;border-radius:0;-webkit-appearance:none;transition:.3s}
  .f input:focus,.f select:focus,.f textarea:focus{border-color:var(--moon)}
  .f select option{color:var(--ink)}
  .f textarea{min-height:70px;resize:vertical}
  .f2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .reply .btn{background:var(--moon-deep);border-color:var(--moon-deep);width:100%;margin-top:10px}
  .reply .btn:hover{background:var(--moon)}

  footer{padding:60px 0;text-align:center}
  footer .k{letter-spacing:.5em}
  footer .brand a{color:var(--moon-deep);text-decoration:none}

  @media(max-width:760px){
    .vgrid,.rgrid{grid-template-columns:1fr}
    .chp{grid-template-columns:1fr;gap:8px}
    .srow{grid-template-columns:1fr;gap:4px}
    .cstrip{grid-template-columns:repeat(2,1fr)}
    .cu:nth-child(3){border-left:0}
    .cu:nth-child(n+3){border-top:1px solid var(--hair)}
    .mbot{flex-direction:column;align-items:flex-start;gap:10px}
    .f2{grid-template-columns:1fr}
  }
</style>
<style><%- themeCss %></style>
</head>
<body class="theme-<%= t.id %>">
<% if (preview) { %><div class="pv-ribbon" style="position:fixed;top:18px;left:-52px;z-index:99999;transform:rotate(-35deg);background:#141412;color:#FAFAF7;font:600 11px/1 Montserrat,Arial,sans-serif;letter-spacing:.22em;padding:11px 58px;box-shadow:0 4px 16px rgba(0,0,0,.3);pointer-events:none">PREVIEW</div>
<style>@media(max-width:640px){.pv-ribbon{top:8px;left:-58px;padding:8px 54px;font-size:9px}}</style><% } %>

<header class="mast">
  <div class="mtop"><span class="k"><%= s.gi %>—<%= s.bi %></span><span class="k"><%= s.year %></span></div>
  <div class="mmid">
    <h1 class="mname"><%= s.groom %></h1>
    <div class="mamp"><span class="ln"></span><em>and</em><span class="ln"></span></div>
    <h1 class="mname b"><%= s.bride %></h1>
  </div>
  <div class="mbot">
    <span class="k">We are getting married · <%= s.dateLong %> · <%= s.venueName %></span>
    <span class="k moon">Scroll</span>
  </div>
</header>

<section class="stmt wrap rv">
  <span class="k moon">The Invitation</span>
  <p>With full hearts, we invite you to witness the beginning of <em>our forever</em> — <%= s.dateMedium %>, at <%= s.timeDisplay %>.</p>
</section>

<div class="wrap rv">
  <div class="cstrip" id="count" data-when="<%= s.countdownISO %>">
    <div class="cu"><b id="cd-d">—</b><span>Days</span></div>
    <div class="cu"><b id="cd-h">—</b><span>Hours</span></div>
    <div class="cu"><b id="cd-m">—</b><span>Minutes</span></div>
    <div class="cu"><b id="cd-s">—</b><span>Seconds</span></div>
  </div>
</div>

<% if ((d.story || []).length) { %>
<section class="chapters wrap">
  <div class="chead rv"><h2>The Story</h2><span class="k moon"><%= d.story.length %> chapters</span></div>
  <% d.story.forEach(function(it, i){ %>
  <article class="chp rv">
    <div class="no">( <%= String(i + 1).padStart(2, '0') %> )</div>
    <div>
      <% if (it.label) { %><span class="k lbl"><%= it.label %></span><% } %>
      <h3><%= it.title %></h3>
      <p><%= it.text %></p>
    </div>
  </article>
  <% }) %>
</section>
<% } %>

<% if (img.groom || img.bride) { %>
<section class="wrap">
  <div class="duo">
    <% if (img.groom) { %><figure class="rv"><div class="frame"><img src="<%= img.groom %>" alt="<%= s.groom %>" loading="lazy" /></div><figcaption><span class="nm"><%= s.groom %></span><span class="rl">Groom</span></figcaption></figure><% } %>
    <% if (img.bride) { %><figure class="rv"><div class="frame"><img src="<%= img.bride %>" alt="<%= s.bride %>" loading="lazy" /></div><figcaption><span class="nm"><%= s.bride %></span><span class="rl">Bride</span></figcaption></figure><% } %>
  </div>
</section>
<% } %>

<% if ((d.program || []).length) { %>
<section class="sched wrap">
  <div class="chead rv"><h2>The Day</h2><span class="k moon"><%= s.dateShort %></span></div>
  <% d.program.forEach(function(it){ %>
  <div class="srow rv">
    <time><%= it.time %></time>
    <div><h4><%= it.title %></h4><% if (it.text) { %><p><%= it.text %></p><% } %></div>
  </div>
  <% }) %>
</section>
<% } %>

<section class="ven wrap" id="venue">
  <div class="vgrid">
    <img class="rv" src="<%= img.venue %>" alt="<%= s.venueName %>" loading="lazy" />
    <div class="vinfo rv">
      <span class="k moon">The Place</span>
      <h3><%= s.venueName %></h3>
      <% if (s.venueAddress) { %><p><%= s.venueAddress %></p><% } %>
      <div class="vfacts">
        <div><span>Ceremony</span><b><%= s.timeDisplay %></b></div>
        <div><span>Arrive by</span><b><%= s.arriveDisplay %></b></div>
        <% if (s.rsvpByDisplay) { %><div><span>RSVP by</span><b><%= s.rsvpByDisplay %></b></div><% } %>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(s.mapQuery) %>" target="_blank" rel="noopener">Directions</a>
        <% if (s.venueWebsite) { %><a class="btn ghost" href="<%= s.venueWebsite %>" target="_blank" rel="noopener">Website</a><% } %>
      </div>
    </div>
  </div>
</section>

<section class="reply" id="rsvp">
  <div class="wrap">
    <span class="k rv">Kindly reply<% if (s.rsvpByDisplay) { %> by <%= s.rsvpByDisplay %><% } %></span>
    <h2 class="rv">Will you<br>join us</h2>
    <div class="rgrid">
      <div class="rleft rv">
        <p>One tap writes your reply in WhatsApp — send it as it is, or add a line of your own.</p>
        <div class="who">
          <% (d.contacts || []).forEach(function(c){ if (!c.name && !c.phone) return; %>
          <div>
            <div><span class="nm"><%= c.name %></span><span class="rl"><%= c.role %></span></div>
            <div style="display:flex;gap:18px">
              <% if (c.wa) { %><a href="https://wa.me/<%= String(c.wa).replace(/\D/g,'') %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
              <% if (c.phone) { %><a href="tel:<%= c.phone.replace(/\s/g,'') %>">Call</a><% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <form class="rv" id="rsvpForm">
        <div class="f"><label>Name</label><input id="rName" required placeholder="Your full name" /></div>
        <div class="f2">
          <div class="f"><label>Attending</label><select id="rGo"><option>Joyfully accepts</option><option>Regretfully declines</option></select></div>
          <div class="f"><label>Guests</label><select id="rNum"><option>1</option><option>2</option><option>3</option><option>4</option><option>5+</option></select></div>
        </div>
        <div class="f"><label>Note (optional)</label><textarea id="rMsg" placeholder="Anything we should know"></textarea></div>
        <button class="btn" type="submit">Send via WhatsApp</button>
      </form>
    </div>
  </div>
</section>

<footer>
  <span class="k"><%= s.coupleTitle %> · <%= s.dateShort %></span><br><br>
  <span class="k brand">Crafted with <a href="<%= brandBase %>" target="_blank" rel="noopener">Poruwe</a></span>
</footer>

<script>
(function(){
  'use strict';
  var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .13 });
  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
  var when = new Date(document.getElementById('count').dataset.when || 0).getTime();
  function cd(id, v){ document.getElementById(id).textContent = String(v).padStart(2, '0'); }
  function tick(){
    var t = Math.max(0, when - Date.now());
    cd('cd-d', Math.floor(t / 864e5)); cd('cd-h', Math.floor(t % 864e5 / 36e5));
    cd('cd-m', Math.floor(t % 36e5 / 6e4)); cd('cd-s', Math.floor(t % 6e4 / 1e3));
  }
  if (when) { tick(); setInterval(tick, 1000); }
  document.getElementById('rsvpForm').addEventListener('submit', function(ev){
    ev.preventDefault();
    <% if (preview) { %>
    alert('This is a preview — the RSVP form starts working the moment the invitation is published.');
    return;
    <% } else { %>
    var name = document.getElementById('rName').value.trim();
    if (!name) return;
    var msg = 'RSVP — <%= s.coupleTitle %> (<%= s.dateShort %>)\n'
      + 'Name: ' + name + '\n'
      + 'Attending: ' + document.getElementById('rGo').value + '\n'
      + 'Guests: ' + document.getElementById('rNum').value
      + (document.getElementById('rMsg').value.trim() ? '\nNote: ' + document.getElementById('rMsg').value.trim() : '');
    window.open('https://wa.me/<%= s.rsvpWa %>?text=' + encodeURIComponent(msg), '_blank');
    <% } %>
  });
})();
</script>
</body>
</html>
