<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/public/icons/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
<title><%= s.groom %> &amp; <%= s.bride %> · <%= s.dateShort %></title>
<meta name="theme-color" content="#1A2C25" />
<!-- Link previews intentionally disabled: no description / Open Graph / Twitter meta, so shared links unfurl with no card. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600&family=Italiana&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style>
  :root{
    --sage:#7A9082;
    --sage-deep:#5f7468;
    --champagne:#D4B896;
    --cream:#F6F3ED;          /* page background */
    --ivory:#FDFBF6;
    --gold:#C8A24B;           /* brand gold — accents, lines, borders, large labels */
    --gold-deep:#9E7B2F;      /* deeper gold for small labels on light bg (readability) */
    --gold-rich:#C8A24B;
    --gold-light:#E2C97E;
    --forest:#1A2C25;         /* dark green */
    --ink:#13251F;            /* primary text */
    --muted:#6D736E;          /* body text */
    --white:#fffdf8;
    --border:rgba(200,162,75,.35);
    --shadow:0 24px 60px -30px rgba(26,44,37,.35);
    --ease:cubic-bezier(.4,0,.2,1);
    --ease-out:cubic-bezier(.16,1,.3,1);
    --serif:'Cormorant Garamond',Georgia,serif;
    --display:'Cormorant Garamond',Georgia,serif;
    --script:'Italiana',Georgia,serif;
    --sans:'Montserrat',-apple-system,BlinkMacSystemFont,sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    font-family:var(--serif);
    color:var(--muted);
    background:var(--cream);
    line-height:1.8;
    font-weight:400;
    font-size:1.08rem;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{font-family:var(--display);font-weight:300;line-height:1.08;color:var(--ink)}
  ::selection{background:var(--gold);color:var(--forest)}

  /* Scroll progress bar */
  #scroll-progress{position:fixed;top:0;left:0;height:3px;width:0;z-index:9997;
    background:linear-gradient(90deg,var(--gold),var(--gold-light));transition:width .12s linear;pointer-events:none}

  /* ---------- Helpers ---------- */
  .container{max-width:1120px;margin:0 auto;padding:0 28px}
  .eyebrow{
    font-family:var(--sans);
    font-size:.74rem;
    letter-spacing:.34em;
    text-transform:uppercase;
    color:var(--gold-deep);
    font-weight:600;
    display:inline-block;
    margin-bottom:20px;
  }
  .section{padding:150px 0;position:relative}
  .section-title{
    font-size:clamp(2.3rem,5.4vw,3.8rem);
    font-weight:300;
    letter-spacing:.015em;
    color:var(--ink);
    margin-bottom:8px;
  }
  .ornament{
    display:flex;align-items:center;justify-content:center;gap:16px;
    margin:20px 0 52px;color:var(--gold);
  }
  .ornament::before,.ornament::after{
    content:"";height:1px;width:64px;background:linear-gradient(90deg,transparent,var(--gold));
  }
  .ornament::after{background:linear-gradient(90deg,var(--gold),transparent)}
  .ornament span{font-family:var(--script);font-size:1.4rem}

  .reveal{opacity:0;transform:translateY(50px);filter:blur(6px);transition:opacity 1.2s var(--ease-out),transform 1.2s var(--ease-out),filter 1.2s var(--ease-out)}
  .reveal.in{opacity:1;transform:none;filter:blur(0)}
  /* Blur-to-focus + slow scale images */
  .blurfocus img{filter:blur(16px);transform:scale(1.05);transition:filter 1.4s var(--ease-out),transform 1.6s var(--ease-out)}
  .blurfocus.in img{filter:blur(0);transform:scale(1)}
  @media (prefers-reduced-motion: reduce){
    .reveal,.blurfocus img{transition:none!important;filter:none!important;transform:none!important;opacity:1!important}
    .opening-card,.card-decor,.op-monogram,#op-name-a,#op-name-b,.op-amp,.op-subtitle,.op-date,.op-enter-btn{transition:none!important;filter:none!important}
    html{scroll-behavior:auto}
  }

  /* ---------- Opening / Landing Cover ---------- */
  #opening{
    position:fixed;inset:0;z-index:9999;background:var(--cream);
    display:flex;align-items:center;justify-content:center;overflow:hidden;
  }
  #opening.fade-out{animation:openingFadeOut 1.5s cubic-bezier(.6,0,.2,1) forwards}
  @keyframes openingFadeOut{0%{opacity:1;transform:scale(1);filter:blur(0)}100%{opacity:0;transform:scale(1.06);filter:blur(10px);pointer-events:none}}
  #opening-canvas{position:absolute;inset:0;width:100%;height:100%}
  .opening-card-container{position:relative;z-index:2;padding:16px;display:flex;align-items:center;justify-content:center;width:100%;height:100%}
  .opening-card{
    position:relative;width:100%;max-width:450px;padding:56px 40px;
    background:rgba(253,251,246,.72);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
    border:1px solid rgba(200,162,75,.3);border-radius:8px;
    box-shadow:0 24px 70px rgba(26,40,32,.07),inset 0 0 0 1px rgba(255,255,255,.7);
    opacity:0;transform:scale(.94) translateY(18px);filter:blur(12px);
    transition:opacity 2s var(--ease-out),transform 2s var(--ease-out),filter 2s var(--ease-out);
    display:flex;flex-direction:column;align-items:center;
  }
  #opening.loaded .opening-card{opacity:1;transform:scale(1) translateY(0);filter:blur(0)}
  .opening-card.exit{transform:scale(1.05) translateY(-26px);opacity:0;filter:blur(6px);transition:opacity 1s cubic-bezier(.6,0,.2,1),transform 1s cubic-bezier(.6,0,.2,1),filter 1s cubic-bezier(.6,0,.2,1)}
  .card-decor{position:absolute;width:44px;height:44px;pointer-events:none;opacity:0;transform:scale(.8);transition:opacity 1.5s var(--ease-out) .8s,transform 1.5s var(--ease-out) .8s}
  #opening.loaded .card-decor{opacity:.65;transform:scale(1)}
  .card-decor svg{width:100%;height:100%}
  .card-decor-tl{top:16px;left:16px}
  .card-decor-tr{top:16px;right:16px}
  .card-decor-bl{bottom:16px;left:16px}
  .card-decor-br{bottom:16px;right:16px}
  .opening-center{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center;width:100%}
  .op-monogram{
    font-family:var(--serif);font-size:1.5rem;font-style:italic;font-weight:300;color:var(--gold-rich);
    letter-spacing:.15em;margin-bottom:24px;opacity:0;transform:translateY(-6px);filter:blur(4px);
    transition:opacity 1.4s var(--ease-out) .65s,transform 1.4s var(--ease-out) .65s,filter 1.4s var(--ease-out) .65s;
  }
  #opening.loaded .op-monogram{opacity:.85;transform:translateY(0);filter:blur(0)}
  .op-names{display:flex;flex-direction:column;align-items:center;gap:.2em}
  .op-name{font-family:var(--serif);font-weight:300;color:var(--forest);text-transform:uppercase;letter-spacing:.14em;line-height:1;white-space:nowrap;font-size:clamp(2.5rem,7vw,4.5rem)}
  #op-name-a,#op-name-b{opacity:0;transform:translateY(32px);filter:blur(9px);transition:opacity 1.6s var(--ease-out),transform 1.6s var(--ease-out),filter 1.6s var(--ease-out)}
  .op-amp{font-family:var(--serif);font-style:italic;font-size:clamp(1.2rem,3vw,2rem);font-weight:300;color:var(--gold-rich);letter-spacing:.2em;line-height:1;opacity:0;transform:scale(.8);filter:blur(6px);transition:opacity 1.3s var(--ease-out),transform 1.3s var(--ease-out),filter 1.3s var(--ease-out);padding:.15em 0}
  .op-line{width:0;height:1px;background:linear-gradient(90deg,transparent,var(--gold-rich),transparent);margin:28px auto 0;transition:width 2s var(--ease-out)}
  .op-subtitle{font-family:var(--sans);font-size:clamp(.6rem,1.5vw,.72rem);font-weight:500;letter-spacing:.35em;color:var(--gold-rich);text-transform:uppercase;opacity:0;transform:translateY(12px);filter:blur(4px);transition:opacity 1.3s var(--ease-out),transform 1.3s var(--ease-out),filter 1.3s var(--ease-out);margin-top:18px}
  .op-date{font-family:var(--serif);font-size:clamp(.95rem,2vw,1.15rem);font-weight:300;font-style:italic;color:var(--muted);opacity:0;transform:translateY(10px);filter:blur(4px);transition:opacity 1.3s var(--ease-out),transform 1.3s var(--ease-out),filter 1.3s var(--ease-out);margin-top:8px}
  .op-enter-btn{margin-top:36px;opacity:0;transform:translateY(18px);filter:blur(4px);transition:opacity 1.3s var(--ease-out),transform 1.3s var(--ease-out),filter 1.3s var(--ease-out);display:flex;justify-content:center;align-items:center}
  .wax-seal-wrapper{display:flex;flex-direction:column;align-items:center;gap:12px;cursor:pointer;position:relative}
  .wax-seal{width:76px;height:76px;animation:sealBreathe 3s ease-in-out infinite;transform-origin:center;transition:transform .4s cubic-bezier(.34,1.56,.64,1),filter .4s ease;filter:drop-shadow(0 4px 12px rgba(26,40,32,.15))}
  .wax-seal svg{width:100%;height:100%;display:block}
  .wax-seal-wrapper:hover .wax-seal{animation-play-state:paused;transform:scale(1.08) rotate(4deg);filter:drop-shadow(0 8px 20px rgba(200,162,75,.35)) brightness(1.03)}
  .wax-seal-wrapper:active .wax-seal{transform:scale(.94) rotate(-2deg);filter:drop-shadow(0 2px 6px rgba(26,40,32,.2))}
  .wax-seal.broken{animation:sealBreak .7s cubic-bezier(.36,.07,.19,.97) forwards!important}
  .wax-seal-hint{font-family:var(--sans);font-size:.58rem;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--gold-rich);opacity:.75;transition:all .3s ease;position:relative}
  .wax-seal-hint::after{content:'';position:absolute;bottom:-4px;left:50%;width:0;height:1px;background:var(--gold-light);transition:all .3s ease;transform:translateX(-50%)}
  .wax-seal-wrapper:hover .wax-seal-hint{opacity:1;color:var(--gold-light);letter-spacing:.32em}
  .wax-seal-wrapper:hover .wax-seal-hint::after{width:40px}
  @keyframes sealBreathe{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}
  @keyframes sealBreak{0%{transform:scale(1)}25%{transform:scale(.85);filter:brightness(1.15)}100%{transform:scale(1.5);opacity:0;filter:blur(4px)}}
  @media(max-width:480px){
    .opening-card{padding:44px 26px}
    .card-decor{width:32px;height:32px}
    .card-decor-tl{top:12px;left:12px}.card-decor-tr{top:12px;right:12px}
    .card-decor-bl{bottom:12px;left:12px}.card-decor-br{bottom:12px;right:12px}
    .op-monogram{margin-bottom:16px}
    .op-line{margin:24px auto 0}
  }

  /* ---------- Nav ---------- */
  header.nav{
    position:fixed;top:0;left:0;right:0;z-index:100;
    display:flex;align-items:center;justify-content:space-between;
    padding:22px 44px;transition:all .5s var(--ease);
    background:rgba(246,243,237,.35);
    backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  }
  header.nav.scrolled{
    background:rgba(246,243,237,.9);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    padding:15px 44px;
    box-shadow:0 6px 30px -18px rgba(26,44,37,.5);
    border-bottom:1px solid var(--border);
  }
  .brand{
    font-family:var(--serif);font-style:italic;font-size:2.1rem;color:var(--gold);
    letter-spacing:.12em;transition:color .4s var(--ease);text-decoration:none;
  }
  header.nav.scrolled .brand{color:var(--gold)}
  .brand b{color:var(--gold);font-weight:400;font-style:italic;font-family:var(--serif)}
  .nav-right{display:flex;align-items:center;gap:38px}
  .nav-links{display:flex;align-items:center;gap:36px;list-style:none}
  .nav-links a{
    color:var(--ink);text-decoration:none;font-size:.84rem;font-family:var(--sans);
    letter-spacing:.22em;text-transform:uppercase;font-weight:500;transition:.4s var(--ease);
    position:relative;
  }
  header.nav.scrolled .nav-links a{color:var(--ink)}
  .nav-links a:not(.btn-rsvp):hover{color:var(--gold-deep)}
  .nav-links a:not(.btn-rsvp)::after{
    content:"";position:absolute;left:0;bottom:-6px;width:0;height:1px;
    background:var(--gold);transition:width .4s var(--ease);
  }
  .nav-links a:not(.btn-rsvp):hover::after{width:100%}
  .btn-rsvp{
    position:relative;overflow:hidden;
    background:transparent;color:var(--gold-deep)!important;text-decoration:none;
    padding:14px 36px;border-radius:2px;letter-spacing:.24em;font-weight:600;font-size:.92rem;
    transition:all .4s var(--ease);border:1.5px solid var(--gold);
  }
  .btn-rsvp:hover{background:var(--gold);color:var(--forest)!important;transform:scale(1.03);box-shadow:0 14px 34px -16px rgba(200,162,75,.85),0 0 20px -6px rgba(226,201,126,.6)}
  .btn-rsvp:active{transform:scale(.98)}
  header.nav.scrolled .btn-rsvp{color:var(--gold-deep)!important}
  header.nav.scrolled .btn-rsvp:hover{color:var(--forest)!important}

  /* ---------- Hero ---------- */
  .hero{
    min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;position:relative;color:var(--forest);overflow:hidden;padding:118px 0 46px;
  }
  .hero-bg{
    position:absolute;inset:0;
    background:url('<%= img.hero %>') center/cover no-repeat;
    transform:scale(1.2);transform-origin:center;will-change:transform;
  }
  .hero-bg::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(180deg,rgba(245,241,232,.6),rgba(245,241,232,.32) 38%,rgba(245,241,232,.55) 76%,rgba(245,241,232,.94));
  }
  .hero-petals{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}
  .hero-content{position:relative;z-index:2;width:100%;display:flex;flex-direction:column;align-items:center}
  .hero-inner{padding:0 24px;max-width:920px}
  .hero-date{
    font-family:var(--sans);letter-spacing:.34em;text-transform:uppercase;font-weight:600;
    font-size:clamp(.66rem,1.7vw,.86rem);color:var(--gold-deep);margin-bottom:16px;
    text-shadow:0 1px 16px rgba(246,243,237,.7);
  }
  .hero-names{
    display:flex;flex-direction:column;align-items:center;gap:.02em;
    font-family:var(--serif);font-weight:300;color:var(--forest);
    text-transform:uppercase;letter-spacing:.1em;line-height:1.02;
    text-shadow:0 2px 34px rgba(245,241,232,.65);
  }
  .hero-names .nm{font-size:clamp(2.7rem,12vw,7rem);white-space:nowrap}
  .hero-names .ch{display:inline-block;will-change:transform,opacity}
  .hero-names .amp{
    font-family:var(--serif);font-style:italic;font-weight:300;color:var(--gold-rich);
    font-size:clamp(1.3rem,3.6vw,2.4rem);letter-spacing:.14em;padding:.04em 0;
  }
  .hero-loc{margin-top:22px}
  .hero-loc em{display:block;font-family:var(--serif);font-style:italic;font-size:clamp(1.15rem,2.7vw,1.6rem);color:var(--forest);text-shadow:0 1px 18px rgba(246,243,237,.7)}
  .hero-loc span{display:block;font-family:var(--sans);font-size:clamp(.62rem,1.5vw,.74rem);letter-spacing:.28em;font-weight:500;text-transform:uppercase;color:var(--forest);margin-top:8px;text-shadow:0 1px 14px rgba(246,243,237,.75)}
  .hero-countdown{
    display:flex;width:100%;margin:46px 0 0;
    background:rgba(250,247,240,.8);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);
    border-top:1px solid rgba(200,162,75,.22);border-bottom:1px solid rgba(200,162,75,.22);
  }
  .cd-item{flex:1;padding:24px 6px;position:relative;text-align:center}
  .cd-item + .cd-item::before{content:"";position:absolute;left:0;top:22%;bottom:22%;width:1px;background:rgba(26,40,32,.12)}
  .cd-num{font-family:var(--serif);font-weight:300;font-size:clamp(1.9rem,6.5vw,3.4rem);line-height:1;color:var(--forest);letter-spacing:.02em}
  .cd-unit{font-family:var(--sans);font-size:clamp(.54rem,1.4vw,.72rem);letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-top:10px}
  .hero-cta{display:flex;flex-direction:column;align-items:center;gap:15px;margin-top:42px;padding:0 24px;width:100%;max-width:470px}
  #confetti{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9998}
  .btn{
    position:relative;overflow:hidden;
    display:inline-flex;align-items:center;justify-content:center;
    padding:15px 34px;border-radius:2px;text-decoration:none;
    font-size:.76rem;letter-spacing:.22em;text-transform:uppercase;transition:all .4s var(--ease);cursor:pointer;
    font-weight:600;border:1px solid transparent;font-family:var(--sans);
  }
  .btn:hover{transform:scale(1.03)}
  .btn:active{transform:scale(.98)}
  .btn-solid{background:var(--champagne);color:var(--forest)}
  .btn-solid:hover{background:var(--white);box-shadow:0 14px 34px -16px rgba(26,44,37,.6)}
  .hero-cta .btn{width:100%;min-height:48px;border-radius:2px;padding:0 30px;letter-spacing:3px;font-weight:600}
  .btn-gold{background:var(--gold);color:var(--forest);box-shadow:0 12px 30px -14px rgba(158,123,47,.7)}
  .btn-gold:hover{background:var(--gold-light);box-shadow:0 20px 46px -14px rgba(200,162,75,.9),0 0 22px -6px rgba(226,201,126,.7)}
  .btn-outline{background:transparent;border-color:var(--forest);color:var(--forest)}
  .btn-outline:hover{background:var(--forest);color:var(--cream);box-shadow:0 16px 38px -16px rgba(26,44,37,.6)}
  /* button ripple */
  .ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.45);transform:scale(0);animation:rippleFx .6s ease-out forwards;pointer-events:none}
  @keyframes rippleFx{to{transform:scale(2.6);opacity:0}}

  /* ---------- Story (vertical timeline) ---------- */
  .story{background:var(--cream)}
  .timeline{max-width:780px;margin:0 auto;position:relative}
  .timeline::before{
    content:"";position:absolute;left:27px;top:14px;bottom:14px;width:1.5px;background:var(--gold);
    transform:scaleY(0);transform-origin:top;transition:transform 1.6s var(--ease-out);
  }
  .timeline.line-in::before{transform:scaleY(1)}
  .tl-item.in .tl-icon{box-shadow:0 0 0 7px rgba(200,162,75,.12);animation:iconPop .7s var(--ease-out)}
  @keyframes iconPop{0%{transform:scale(.6);opacity:0}60%{transform:scale(1.08)}100%{transform:scale(1);opacity:1}}
  .tl-item{position:relative;width:100%;padding:0 0 78px 92px;text-align:left}
  .tl-item:last-child{padding-bottom:0}
  .tl-icon{
    position:absolute;left:0;top:0;width:56px;height:56px;border-radius:50%;
    background:var(--cream);border:1.5px solid var(--gold);color:var(--gold-deep);
    display:flex;align-items:center;justify-content:center;transition:box-shadow .6s var(--ease);
  }
  .tl-icon svg{width:24px;height:24px}
  .tl-item:last-child .tl-icon{background:var(--gold);color:var(--cream);border-color:var(--gold)}
  .tl-item.in .tl-icon{box-shadow:0 0 0 7px rgba(200,162,75,.12)}
  .tl-date{font-family:var(--sans);font-size:.74rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold-deep);font-weight:600;margin-bottom:12px}
  .tl-item h3{font-family:var(--display);font-style:italic;font-weight:400;font-size:clamp(1.9rem,4.6vw,2.7rem);color:var(--ink);margin-bottom:14px;line-height:1.05}
  .tl-item p{color:var(--muted);font-size:1.18rem;line-height:1.7;max-width:580px}

  /* ---------- Program ---------- */
  .program{background:linear-gradient(180deg,var(--cream),#efe9dc)}
  .prog-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:30px;max-width:920px;margin:0 auto}
  .prog-card{
    background:var(--white);border-radius:18px;padding:34px 32px;display:flex;gap:22px;align-items:flex-start;
    box-shadow:var(--shadow);border:1px solid rgba(200,169,122,.18);transition:.4s;
  }
  .prog-card:hover{transform:translateY(-6px)}
  .prog-time{
    font-family:var(--display);font-size:1.2rem;color:var(--gold);min-width:74px;
    border-right:1px solid rgba(200,169,122,.4);padding-right:18px;
  }
  .prog-card h3{font-size:1.3rem;color:var(--forest);margin-bottom:4px}
  .prog-card p{color:var(--muted);font-size:.95rem}

  /* ---------- Venue ---------- */
  .venue{background:var(--forest);color:#fff;padding:0;overflow:hidden}
  .venue .venue-img{position:relative;width:100%;height:clamp(240px,40vh,440px);overflow:hidden;box-shadow:none}
  .venue-img img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.9)}
  .venue-body{max-width:1000px;margin:0 auto;padding:96px 28px 124px}
  .venue-eyebrow{font-family:var(--sans);font-size:.74rem;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:18px}
  .venue-name{font-family:var(--display);font-weight:300;font-size:clamp(2.6rem,7.5vw,4.4rem);line-height:1;color:#fff;margin-bottom:58px}
  .venue-name em{font-style:italic;color:var(--gold)}
  .venue-cards{display:flex;flex-direction:column}
  .vcard{display:flex;gap:24px;align-items:flex-start;padding:32px 0;border-bottom:1px solid var(--border);transition:transform .4s var(--ease)}
  .vcard:hover{transform:translateY(-4px)}
  .vcard:first-child{border-top:1px solid var(--border)}
  .vcard .ic{width:48px;height:48px;border-radius:50%;border:1px solid var(--border);color:var(--gold);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .4s var(--ease)}
  .vcard:hover .ic{background:var(--gold);color:var(--forest);border-color:var(--gold);transform:translateY(-2px)}
  .vcard .ic svg{width:22px;height:22px}
  .vcard h4{font-family:var(--sans);font-size:.76rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:9px}
  .vcard p{color:rgba(255,255,255,.82);font-size:1.18rem;line-height:1.6}
  .venue-actions{display:flex;flex-wrap:wrap;gap:16px;margin-top:56px}
  .venue-actions .btn{min-height:48px;letter-spacing:3px;padding:0 34px}
  .btn-goldline{background:transparent;border:1.5px solid var(--gold);color:var(--gold)}
  .btn-goldline:hover{background:var(--gold);color:var(--forest);box-shadow:0 18px 40px -16px rgba(200,162,75,.8),0 0 20px -6px rgba(226,201,126,.6)}

  /* ---------- RSVP ---------- */
  .rsvp{
    position:relative;color:var(--cream);text-align:center;overflow:hidden;
  }
  .rsvp-bg{
    position:absolute;inset:0;
    background:url('<%= img.rsvpBg %>') center/cover fixed no-repeat;
  }
  .rsvp-bg::after{content:"";position:absolute;inset:0;background:rgba(20,30,24,.82)}
  .rsvp .container{position:relative;z-index:2}
  .rsvp .section-title{color:var(--white)}
  .rsvp .eyebrow{color:var(--champagne)}
  .rsvp .intro{max-width:540px;margin:0 auto 44px;color:rgba(245,241,232,.85)}
  form#rsvp-form{max-width:620px;margin:0 auto;text-align:left}
  .field{margin-bottom:22px}
  .field label{display:block;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--champagne);margin-bottom:9px}
  .field input,.field select,.field textarea{
    width:100%;padding:14px 18px;background:rgba(255,255,255,.07);border:1px solid rgba(245,241,232,.25);
    border-radius:10px;color:var(--white);font-family:var(--sans);font-size:.95rem;font-weight:300;transition:.3s;
  }
  .field input::placeholder,.field textarea::placeholder{color:rgba(245,241,232,.4)}
  .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--gold);background:rgba(255,255,255,.12)}
  .field select option{color:var(--ink)}
  .field textarea{resize:vertical;min-height:90px}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .rsvp .btn-solid{width:100%;margin-top:8px;font-size:.82rem;padding:16px}
  .rsvp-alt{margin-top:30px;font-size:.85rem;color:rgba(245,241,232,.8)}
  .rsvp-alt a{color:var(--champagne);text-decoration:none;border-bottom:1px solid transparent;transition:.3s}
  .rsvp-alt a:hover{border-color:var(--champagne)}
  .rsvp-success{
    display:none;background:rgba(122,144,130,.25);border:1px solid var(--sage);
    border-radius:14px;padding:28px;text-align:center;margin-top:10px;
  }
  .rsvp-success.show{display:block;animation:pop .5s ease}
  @keyframes pop{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:none}}
  .rsvp-success h3{color:var(--white);margin-bottom:6px}
  .rsvp-success p{color:rgba(245,241,232,.85);font-size:.95rem}

  /* ---------- Contact ---------- */
  .contact{background:var(--cream);text-align:center}
  .contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:40px;max-width:820px;margin:0 auto}
  .contact-card{
    background:var(--white);border-radius:20px;padding:46px 34px;box-shadow:var(--shadow);
    border:1px solid rgba(200,169,122,.18);transition:.4s;
  }
  .contact-card:hover{transform:translateY(-6px)}
  .contact-avatar{
    width:112px;height:112px;border-radius:50%;margin:0 auto 24px;overflow:hidden;
    border:2px solid var(--gold);box-shadow:0 10px 28px -12px rgba(26,44,37,.45);
  }
  .contact-avatar img{width:100%;height:100%;object-fit:cover;display:block}
  .contact-avatar-init{display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--sage),var(--sage-deep));color:var(--cream);font-family:var(--display);font-size:2.6rem;overflow:hidden}
  .contact-card .role{font-family:var(--sans);font-size:.68rem;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:var(--gold-deep);margin-bottom:8px}
  .contact-card h3{font-family:var(--display);font-style:italic;font-size:2rem;color:var(--ink);margin-bottom:14px}
  .contact-card .ph{font-family:var(--sans);font-weight:500;color:var(--forest);font-size:1.02rem;margin-bottom:24px;letter-spacing:.05em;text-decoration:none}
  .contact-links{display:flex;gap:12px;justify-content:center}
  .contact-links a{
    display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:2px;font-family:var(--sans);font-weight:600;
    font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none;transition:all .4s var(--ease);
  }
  .contact-links a svg{width:16px;height:16px;flex-shrink:0}
  .contact-links a:active{transform:scale(.97)}
  .lk-wa{background:var(--sage);color:var(--white)}
  .lk-wa:hover{background:var(--sage-deep)}
  .lk-call{border:1px solid var(--gold);color:var(--gold)}
  .lk-call:hover{background:var(--gold);color:var(--white)}

  /* ---------- Footer ---------- */
  footer{background:var(--forest);color:var(--cream);text-align:center;padding:96px 24px 56px}
  footer .names{font-family:var(--display);font-weight:300;font-size:clamp(2.2rem,6vw,3.2rem);margin-bottom:10px}
  footer .names .amp{font-family:var(--serif);font-style:italic;color:var(--gold)}
  footer .f-date{font-family:var(--sans);letter-spacing:.3em;text-transform:uppercase;font-size:.74rem;font-weight:500;color:var(--gold);margin-bottom:8px}
  footer .f-loc{font-family:var(--sans);font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;opacity:.7}
  footer .f-orn{margin:34px 0}
  footer .made{font-family:var(--script);font-size:1.25rem;opacity:.9;color:var(--gold-light)}
  footer .copy{font-family:var(--sans);margin-top:26px;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;opacity:.45}

  /* ---------- Responsive ---------- */
  @media(max-width:860px){
    .nav-links{display:none}
    .venue-body{padding:64px 24px 88px}
    .venue-actions{flex-direction:column}
    .venue-actions .btn{width:100%}
    .prog-grid,.contact-grid{grid-template-columns:1fr}
    .timeline::before{left:23px}
    .tl-item{padding:0 0 60px 66px}
    .tl-icon{width:48px;height:48px}
    .tl-icon svg{width:21px;height:21px}
    .field-row{grid-template-columns:1fr;gap:0}
    .section{padding:84px 0}
    .section.venue{padding:0} /* the venue leads with its full-bleed image — no green band above it */
    header.nav,header.nav.scrolled{padding:16px 24px}
  }
</style>
<meta name="robots" content="noindex" />
<style><%- themeCss %></style>
</head>
<body class="theme-<%= t.id %>">
<% if (preview) { %><div class="pv-ribbon" style="position:fixed;top:18px;left:-52px;z-index:99999;transform:rotate(-35deg);background:#C8A24B;color:#1A2C25;font:600 11px/1 Montserrat,Arial,sans-serif;letter-spacing:.22em;padding:11px 58px;box-shadow:0 4px 16px rgba(0,0,0,.3);pointer-events:none">PREVIEW</div>
<style>@media(max-width:640px){.pv-ribbon{top:8px;left:-58px;padding:8px 54px;font-size:9px}header.nav .brand{margin-left:48px}header.nav{padding-left:16px}}</style><% } %>

<!-- ===== OPENING / LANDING COVER ===== -->
<div id="opening">
  <canvas id="opening-canvas"></canvas>
  <div class="opening-card-container">
    <div class="opening-card" id="op-card">
      <div class="card-decor card-decor-tl">
        <svg viewBox="0 0 100 100" fill="none" stroke="var(--gold-rich)" stroke-width="1.5"><path d="M 10,40 L 10,10 L 40,10 M 18,32 L 18,18 L 32,18 M 10,10 L 32,32" stroke-linecap="round"/></svg>
      </div>
      <div class="card-decor card-decor-tr">
        <svg viewBox="0 0 100 100" fill="none" stroke="var(--gold-rich)" stroke-width="1.5"><path d="M 90,40 L 90,10 L 60,10 M 82,32 L 82,18 L 68,18 M 90,10 L 68,32" stroke-linecap="round"/></svg>
      </div>
      <div class="card-decor card-decor-bl">
        <svg viewBox="0 0 100 100" fill="none" stroke="var(--gold-rich)" stroke-width="1.5"><path d="M 10,60 L 10,90 L 40,90 M 18,68 L 18,82 L 32,82 M 10,90 L 32,68" stroke-linecap="round"/></svg>
      </div>
      <div class="card-decor card-decor-br">
        <svg viewBox="0 0 100 100" fill="none" stroke="var(--gold-rich)" stroke-width="1.5"><path d="M 90,60 L 90,90 L 60,90 M 82,68 L 82,82 L 68,82 M 90,90 L 68,68" stroke-linecap="round"/></svg>
      </div>

      <div class="opening-center">
        <div class="op-monogram"><%= s.gi %> &amp; <%= s.bi %></div>
        <div class="op-names">
          <div class="op-name" id="op-name-a"><%= s.groom %></div>
          <div class="op-amp" id="op-amp">&amp;</div>
          <div class="op-name" id="op-name-b"><%= s.bride %></div>
        </div>
        <div class="op-line" id="op-line"></div>
        <div class="op-subtitle" id="op-subtitle">We Are Getting Married</div>
        <div class="op-date" id="op-date"><%= s.dDots %></div>
        <div class="op-enter-btn" id="op-btn">
          <div class="wax-seal-wrapper" onclick="enterSite()" role="button" tabindex="0" aria-label="Open the invitation">
            <div class="wax-seal" id="wax-seal">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <defs>
                  <radialGradient id="wax-grad" cx="45%" cy="45%" r="55%">
                    <stop offset="0%" stop-color="#FDFBF6"/>
                    <stop offset="25%" stop-color="#E2C97E"/>
                    <stop offset="65%" stop-color="#C8A24B"/>
                    <stop offset="90%" stop-color="#9E7B2F"/>
                    <stop offset="100%" stop-color="#6F5119"/>
                  </radialGradient>
                  <filter id="wax-shadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="1" dy="3" stdDeviation="3" flood-color="#1A2820" flood-opacity="0.3"/>
                  </filter>
                </defs>
                <path d="M 50,6 C 68,5 83,11 92,26 C 98,37 95,54 92,69 C 89,82 82,93 67,95 C 53,97 37,93 25,87 C 13,81 3,68 4,51 C 5,34 16,19 30,9 C 38,4 44,5 50,6 Z" fill="url(#wax-grad)" filter="url(#wax-shadow)" />
                <circle cx="50" cy="50" r="31" fill="none" stroke="#6F5119" stroke-width="1.5" opacity="0.3"/>
                <text x="50%" y="58%" font-family="Cormorant Garamond, serif" font-weight="300" font-size="28" font-style="italic" fill="#4B350A" text-anchor="middle" letter-spacing="-1"><%= s.gi %>&amp;<%= s.bi %></text>
                <circle cx="50" cy="50" r="26" fill="none" stroke="#4B350A" stroke-width="0.8" opacity="0.25" stroke-dasharray="2,2"/>
              </svg>
            </div>
            <span class="wax-seal-hint">Tap to Open</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- scroll progress + celebration confetti overlay -->
<div id="scroll-progress"></div>
<canvas id="confetti"></canvas>

