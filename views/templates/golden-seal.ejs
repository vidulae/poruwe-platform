<!-- ===== HERO ===== -->
<section class="hero" id="top">
  <div class="hero-bg" data-parallax="0.08" data-pscale="1.2"></div>
  <canvas class="hero-petals" id="hero-petals"></canvas>
  <div class="hero-content">
    <div class="hero-inner">
      <p class="hero-date"><%= s.dDots %> · Sri Lanka</p>
      <h1 class="hero-names">
        <span class="nm"><%= s.groom %></span>
        <span class="amp">&amp;</span>
        <span class="nm"><%= s.bride %></span>
      </h1>
      <div class="hero-loc">
        <em><%= s.venueName %></em>
        <span><%= s.venueAddress %></span>
      </div>
    </div>
    <div class="hero-countdown">
      <div class="cd-item"><div class="cd-num" id="cd-days">000</div><div class="cd-unit">Days</div></div>
      <div class="cd-item"><div class="cd-num" id="cd-hours">00</div><div class="cd-unit">Hours</div></div>
      <div class="cd-item"><div class="cd-num" id="cd-mins">00</div><div class="cd-unit">Minutes</div></div>
      <div class="cd-item"><div class="cd-num" id="cd-secs">00</div><div class="cd-unit">Seconds</div></div>
    </div>
    <div class="hero-cta">
      <a href="#rsvp" class="btn btn-gold">Reserve Your Place</a>
      <a href="#venue" class="btn btn-outline">Explore Venue</a>
    </div>
  </div>
</section>

<!-- ===== STORY ===== -->
<section class="section story" id="story">
  <div class="container">
    <div class="reveal" style="text-align:center">
      <span class="eyebrow">Our Journey</span>
      <h2 class="section-title">How It All Began</h2>
      <div class="ornament"><span>&#10086;</span></div>
    </div>
    <div class="timeline">
<%
  var tlIcons = [
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 20s-6.5-4.3-9-7.6C1.2 9.9 2.3 6.6 5.2 6c1.9-.4 3.6.6 4.4 2 .8-1.4 2.5-2.4 4.4-2 2.9.6 4 3.9 2.2 6.4C18.5 15.7 12 20 12 20z" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="9" cy="12" r="5.5"/><circle cx="15" cy="12" r="5.5"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="14" r="6"/><path d="M8.5 8l1.5-3h4l1.5 3" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  ];
  var tlHeart = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 20s-6.5-4.3-9-7.6C1.2 9.9 2.3 6.6 5.2 6c1.9-.4 3.6.6 4.4 2 .8-1.4 2.5-2.4 4.4-2 2.9.6 4 3.9 2.2 6.4C18.5 15.7 12 20 12 20z"/></svg>';
  var story = (d.story && d.story.length) ? d.story : [];
%>
<% story.forEach(function(item, i){ var last = (i === story.length - 1); %>
      <div class="tl-item reveal">
        <div class="tl-icon"><%- last ? tlHeart : tlIcons[i % tlIcons.length] %></div>
        <div class="tl-date"><%= item.label || (last ? s.dDots : '') %></div>
        <h3><%= item.title %></h3>
        <p><%= item.text %></p>
      </div>
<% }) %>
    </div>
  </div>
</section>

<!-- ===== PROGRAM ===== -->
<section class="section program" id="program">
  <div class="container">
    <div class="reveal" style="text-align:center">
      <span class="eyebrow">The Celebration</span>
      <h2 class="section-title">The Day Ahead</h2>
      <div class="ornament"><span>&#10086;</span></div>
    </div>
    <div class="prog-grid">
<% (d.program || []).forEach(function(item){ var tp = String(item.time || '').split(' '); %>
      <div class="prog-card reveal"><div class="prog-time"><%= tp[0] %><br><%= tp[1] || '' %></div><div><h3><%= item.title %></h3><p><%= item.text %></p></div></div>
<% }) %>
    </div>
  </div>
</section>

<!-- ===== VENUE ===== -->
<section class="section venue" id="venue">
  <div class="venue-img reveal blurfocus">
    <img src="<%= img.venue %>" alt="<%= s.venueName %>" loading="lazy" decoding="async" />
  </div>
  <div class="venue-body">
    <p class="venue-eyebrow reveal">Where We'll Wed</p>
    <h2 class="venue-name reveal"><% if (s.venueRest) { %><%= s.venueFirst %> <em><%= s.venueRest %></em><% } else { %><em><%= s.venueName %></em><% } %></h2>
    <div class="venue-cards">
      <div class="vcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 22s7-5.6 7-12a7 7 0 1 0-14 0c0 6.4 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
        <div><h4>Address</h4><p><%= s.venueAddress %></p></div>
      </div>
      <div class="vcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4" stroke-linecap="round"/></svg></div>
        <div><h4>Date &amp; Time</h4><p><%= s.dateLong %><br>Ceremony begins at <%= s.timeDisplay %></p></div>
      </div>
      <div class="vcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 11l8-6 8 6M6 10v9h12v-9" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div><h4>Accommodation</h4><p><%= s.accommodation %></p></div>
      </div>
    </div>
    <div class="venue-actions reveal">
      <a class="btn btn-gold" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(s.mapQuery) %>" target="_blank" rel="noopener">Get Directions</a>
      <% if (s.venueWebsite) { %><a class="btn btn-goldline" href="<%= s.venueWebsite %>" target="_blank" rel="noopener">Resort Website</a><% } %>
    </div>
  </div>
</section>

<!-- ===== RSVP ===== -->
<section class="section rsvp" id="rsvp">
  <div class="rsvp-bg"></div>
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">Will You Join Us?</span>
      <h2 class="section-title">RSVP</h2>
      <div class="ornament"><span>&#10086;</span></div>
      <p class="intro">We would be honoured to have you with us. Kindly let us know by <strong><%= s.rsvpByDisplay %></strong> so we can prepare a seat just for you.</p>
    </div>
    <form id="rsvp-form" class="reveal" novalidate>
      <div class="field">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" placeholder="+94 77 123 4567" required />
        </div>
        <div class="field">
          <label for="guests">Number of Guests</label>
          <select id="guests" name="guests">
            <option value="1">1 — Just me</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="diet">Dietary Requirements</label>
        <input type="text" id="diet" name="diet" placeholder="Vegetarian, allergies, etc. (optional)" />
      </div>
      <div class="field">
        <label for="message">A Note for the Couple</label>
        <textarea id="message" name="message" placeholder="Share your wishes (optional)"></textarea>
      </div>
      <button type="submit" class="btn btn-solid">Send My RSVP</button>
      <p class="rsvp-alt">Prefer to reach us directly? <a href="https://wa.me/<%= s.rsvpWa %>" target="_blank" rel="noopener">WhatsApp</a></p>
    </form>
    <div class="rsvp-success" id="rsvp-success">
      <h3>Thank You! &#127881;</h3>
      <p>Your RSVP has been received. We can't wait to celebrate with you on <%= s.dateMedium %>.</p>
    </div>
  </div>
</section>

<!-- ===== CONTACT ===== -->
<section class="section contact" id="contact">
  <div class="container">
    <div class="reveal" style="text-align:center">
      <span class="eyebrow">Get In Touch</span>
      <h2 class="section-title">Contact Us</h2>
      <div class="ornament"><span>&#10086;</span></div>
    </div>
    <div class="contact-grid">
<% (d.contacts || []).forEach(function(c, ci){ var ph = ci === 0 ? img.groom : img.bride; %>
      <div class="contact-card reveal">
        <% if (ph) { %><div class="contact-avatar"><img src="<%= ph %>" alt="<%= c.name %>" loading="lazy" decoding="async" /></div>
        <% } else { %><div class="contact-avatar contact-avatar-init"><%= (c.name || '·')[0].toUpperCase() %></div><% } %>
        <p class="role"><%= c.role %></p>
        <h3><%= c.name %></h3>
        <p class="ph"><%= c.phone %></p>
        <div class="contact-links">
          <% if (c.wa) { %><a class="lk-wa" href="https://wa.me/<%= c.wa %>" target="_blank" rel="noopener" aria-label="WhatsApp <%= c.name %>"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.512 5.26l-.999 3.648 3.876-.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.015-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg> WhatsApp</a><% } %>
          <% if (c.phone) { %><a class="lk-call" href="tel:<%= c.phone.replace(/[^+0-9]/g, '') %>" aria-label="Call <%= c.name %>"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.5 11.5 0 0 0 3.61.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.58 3.61a1 1 0 0 1-.25 1.02l-2.2 2.16z"/></svg> Call</a><% } %>
        </div>
      </div>
<% }) %>
    </div>
  </div>
</section>

<!-- ===== FOOTER ===== -->
<footer>
  <p class="names"><%= s.groom %> <span class="amp">&amp;</span> <%= s.bride %></p>
  <p class="f-date"><%= s.dDots %></p>
  <p class="f-loc"><%= s.venueName %> · <%= s.venueAddress %></p>
  <div class="ornament f-orn"><span>&#10086;</span></div>
  <p class="made">Made with love for our special day</p>
  <p class="copy">&copy; <%= s.year %> <%= s.groom %> &amp; <%= s.bride %> · <a href="<%= brandBase %>" style="color:inherit;text-decoration:none">Crafted on Poruwe</a></p>
</footer>

<script src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"></script>
<script>
  // ---- Opening / landing cover ----
  document.body.style.overflow = 'hidden';
  (function(){
    const canvas = document.getElementById('opening-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let W, H, particles = [], animFrame;
    function resize(){ W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
    resize();
    window.addEventListener('resize', resize);
    function createParticle(){
      return { x:Math.random()*W, y:Math.random()*H, r:Math.random()*1.5+0.3,
        a:Math.random()*0.5+0.1, vx:(Math.random()-0.5)*0.3, vy:(Math.random()-0.5)*0.3, gold:Math.random()>0.5 };
    }
    for (let i=0;i<80;i++) particles.push(createParticle());
    function draw(){
      ctx.clearRect(0,0,W,H);
      particles.forEach(p => {
        ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
        ctx.fillStyle = p.gold ? 'rgba(200,162,75,'+p.a+')' : 'rgba(26,40,32,'+(p.a*0.4)+')';
        ctx.fill();
        if (p.friction){ p.vx*=p.friction; p.vy*=p.friction; p.vy+=p.gravity; p.a*=0.97; }
        p.x+=p.vx; p.y+=p.vy;
        if (!p.friction){ if (p.x<0||p.x>W) p.vx*=-1; if (p.y<0||p.y>H) p.vy*=-1; }
      });
    }
    function loop(){ draw(); animFrame = requestAnimationFrame(loop); }
    loop();
    const opening = document.getElementById('opening');
    setTimeout(() => opening && opening.classList.add('loaded'), 450);
    function reveal(id, delay, scale){
      const el = document.getElementById(id);
      if (!el) return;
      setTimeout(() => { el.style.opacity='1'; el.style.transform = scale ? 'scale(1)' : 'translateY(0)'; el.style.filter='blur(0px)'; }, delay);
    }
    reveal('op-name-a', 1100);
    reveal('op-amp', 1750, true);
    reveal('op-name-b', 2100);
    setTimeout(() => { const l=document.getElementById('op-line'); if (l) l.style.width='240px'; }, 3050);
    reveal('op-subtitle', 3650);
    reveal('op-date', 4200);
    reveal('op-btn', 4800);
    window._openingBurst = () => {
      particles = [];
      const s = document.getElementById('wax-seal');
      const r = s ? s.getBoundingClientRect() : null;
      const sx = r ? r.left + r.width/2 : W/2;
      const sy = r ? r.top + r.height/2 : H/2;
      for (let i=0;i<120;i++){
        const ang = Math.random()*Math.PI*2, sp = Math.random()*3.5+1.5;
        particles.push({ x:sx, y:sy, r:Math.random()*2.5+0.8, a:Math.random()*0.8+0.2,
          vx:Math.cos(ang)*sp, vy:Math.sin(ang)*sp-1.2, gold:Math.random()>0.4, friction:0.98, gravity:0.08 });
      }
    };
    window._stopOpeningCanvas = () => cancelAnimationFrame(animFrame);
  })();

  function enterSite(){
    const seal = document.getElementById('wax-seal');
    const card = document.getElementById('op-card');
    const opening = document.getElementById('opening');
    if (seal) seal.classList.add('broken');
    if (card) card.classList.add('exit');
    if (window._openingBurst) window._openingBurst();
    setTimeout(() => opening.classList.add('fade-out'), 350);
    window._stopOpeningCanvas && window._stopOpeningCanvas();
    setTimeout(() => {
      opening.style.display='none'; document.body.style.overflow=''; window.scrollTo(0,0);
      if (window._lenis) window._lenis.start();
      if (typeof animateHero === 'function') animateHero(); // cinematic hero load sequence
      celebrate(); // 🎉 celebration burst as the site is revealed
    }, 1900);
  }

  // ---- Celebration: gentle falling petals over the hero ----
  (function(){
    const c = document.getElementById('hero-petals');
    if (!c) return;
    const x = c.getContext('2d');
    let W, H, petals = [];
    const COLORS = ['rgba(232,160,160,A)','rgba(226,201,126,A)','rgba(255,255,255,A)','rgba(168,189,179,A)','rgba(212,184,150,A)'];
    function size(){ W = c.width = c.offsetWidth; H = c.height = c.offsetHeight || window.innerHeight; }
    function make(){
      return { x:Math.random()*W, y:Math.random()*-H, vy:Math.random()*0.7+0.35, vx:(Math.random()-0.5)*0.5,
        r:Math.random()*6+4, a:Math.random()*0.4+0.35, rot:Math.random()*Math.PI, vr:(Math.random()-0.5)*0.04,
        sway:Math.random()*Math.PI*2, col:COLORS[Math.floor(Math.random()*COLORS.length)] };
    }
    size();
    window.addEventListener('resize', size);
    for (let i=0;i<26;i++){ const p=make(); p.y=Math.random()*H; petals.push(p); }
    function draw(){
      x.clearRect(0,0,W,H);
      petals.forEach(p => {
        p.sway += 0.02; p.y += p.vy; p.x += p.vx + Math.sin(p.sway)*0.5; p.rot += p.vr;
        if (p.y > H+20){ Object.assign(p, make()); p.y = -20; }
        x.save(); x.translate(p.x,p.y); x.rotate(p.rot);
        x.fillStyle = p.col.replace('A', p.a.toFixed(2));
        x.beginPath(); x.ellipse(0,0,p.r,p.r*0.5,0,0,Math.PI*2); x.fill();
        x.restore();
      });
      requestAnimationFrame(draw);
    }
    draw();
  })();

  // ---- Celebration: confetti burst (fired when the invitation opens) ----
  function celebrate(){
    const c = document.getElementById('confetti');
    if (!c) return;
    const x = c.getContext('2d');
    c.width = window.innerWidth; c.height = window.innerHeight;
    const cols = ['#C8A24B','#E2C97E','#7A9082','#E8A0A0','#FDFBF6','#D4B896'];
    let bits = [];
    for (let i=0;i<170;i++){
      bits.push({ x:Math.random()*c.width, y:-20-Math.random()*c.height*0.5,
        w:Math.random()*8+5, h:Math.random()*5+4, vx:(Math.random()-0.5)*4.5, vy:Math.random()*3+2,
        rot:Math.random()*Math.PI*2, vr:(Math.random()-0.5)*0.32, col:cols[Math.floor(Math.random()*cols.length)], a:1 });
    }
    let frames = 0;
    (function run(){
      x.clearRect(0,0,c.width,c.height);
      let alive = false;
      bits.forEach(b => {
        b.x += b.vx; b.y += b.vy; b.vy += 0.08; b.rot += b.vr;
        if (frames > 95) b.a -= 0.018;
        if (b.a > 0 && b.y < c.height + 40){
          alive = true;
          x.save(); x.globalAlpha = Math.max(0,b.a); x.translate(b.x,b.y); x.rotate(b.rot);
          x.fillStyle = b.col; x.fillRect(-b.w/2,-b.h/2,b.w,b.h); x.restore();
        }
      });
      frames++;
      if (alive && frames < 300) requestAnimationFrame(run);
      else x.clearRect(0,0,c.width,c.height);
    })();
  }
  // Allow keyboard activation of the seal
  document.addEventListener('keydown', (e) => {
    if ((e.key === 'Enter' || e.key === ' ') && document.activeElement && document.activeElement.classList.contains('wax-seal-wrapper')){
      e.preventDefault(); enterSite();
    }
  });

  // ---- Nav scroll state + scroll progress + parallax ----
  const nav = document.getElementById('nav');
  const progress = document.getElementById('scroll-progress');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const parallaxEls = Array.from(document.querySelectorAll('[data-parallax]'));
  let ticking = false;
  function onScroll(){
    const y = window.scrollY;
    nav.classList.toggle('scrolled', y > 60);
    if (progress){
      const h = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.width = (h > 0 ? (y / h) * 100 : 0) + '%';
    }
    if (!reduceMotion){
      parallaxEls.forEach(el => {
        const r = el.getBoundingClientRect();
        if (r.bottom > 0 && r.top < window.innerHeight){
          const speed = parseFloat(el.dataset.parallax) || 0.12;
          const pscale = parseFloat(el.dataset.pscale) || 1.08;
          const offset = (r.top + r.height / 2 - window.innerHeight / 2) * -speed;
          el.style.transform = 'translate3d(0,' + offset.toFixed(1) + 'px,0) scale(' + pscale + ')';
        }
      });
    }
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking){ requestAnimationFrame(onScroll); ticking = true; }
  }, { passive: true });
  onScroll();

  // ---- Countdown ----
  const target = new Date('<%= s.countdownISO %>').getTime();
  const pad = n => String(n).padStart(2, '0');
  const pad3 = n => String(n).padStart(3, '0');
  function tick(){
    const diff = target - Date.now();
    if (diff <= 0){
      document.getElementById('cd-days').textContent = '000';
      ['cd-hours','cd-mins','cd-secs'].forEach(id => document.getElementById(id).textContent = '00');
      return;
    }
    const d = Math.floor(diff / 864e5);
    const h = Math.floor(diff % 864e5 / 36e5);
    const m = Math.floor(diff % 36e5 / 6e4);
    const s = Math.floor(diff % 6e4 / 1e3);
    document.getElementById('cd-days').textContent = pad3(d);
    document.getElementById('cd-hours').textContent = pad(h);
    document.getElementById('cd-mins').textContent = pad(m);
    document.getElementById('cd-secs').textContent = pad(s);
  }
  tick();
  setInterval(tick, 1000);

  // ---- Scroll reveal (staggered, intersection observer) ----
  ['.timeline','.prog-grid','.contact-grid','.venue-cards','.hero-cta','.venue-actions'].forEach(sel => {
    const group = document.querySelector(sel);
    if (!group) return;
    group.querySelectorAll('.reveal').forEach((el,i) => { el.style.transitionDelay = (i * 0.1) + 's'; });
  });
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // ---- Hero name char-stagger (split into letters) ----
  function splitChars(el){
    const text = el.textContent;
    el.textContent = '';
    const frag = document.createDocumentFragment();
    for (const ch of text){ const s = document.createElement('span'); s.className = 'ch'; s.textContent = ch; frag.appendChild(s); }
    el.appendChild(frag);
    return Array.from(el.querySelectorAll('.ch'));
  }
  const heroNameChars = [];
  document.querySelectorAll('.hero-names .nm').forEach(nm => heroNameChars.push(...splitChars(nm)));
  const heroAmp = document.querySelector('.hero-names .amp');
  const heroSeq = ['.hero-date','.hero-loc','.hero-countdown','.hero-cta'].map(s => document.querySelector(s)).filter(Boolean);
  var EO = 'cubic-bezier(.16,1,.3,1)';
  if (!reduceMotion){
    heroSeq.forEach(el => { el.style.opacity='0'; el.style.transform='translateY(30px)'; el.style.transition='opacity 1s '+EO+',transform 1s '+EO; });
    heroNameChars.forEach(ch => { ch.style.opacity='0'; ch.style.transform='translateY(28px)'; ch.style.transition='opacity .7s '+EO+',transform .7s '+EO; });
    if (heroAmp){ heroAmp.style.opacity='0'; heroAmp.style.transform='scale(.6)'; heroAmp.style.transition='opacity .7s '+EO+',transform .7s cubic-bezier(.34,1.56,.64,1)'; }
  }
  let heroAnimated = false;
  function animateHero(){
    if (heroAnimated || reduceMotion) return; heroAnimated = true;
    const date = document.querySelector('.hero-date');
    if (date) setTimeout(() => { date.style.opacity='1'; date.style.transform='none'; }, 150);          // 3. date
    heroNameChars.forEach((ch,i) => setTimeout(() => { ch.style.opacity='1'; ch.style.transform='none'; }, 450 + i*55)); // 4. names letter by letter
    if (heroAmp) setTimeout(() => { heroAmp.style.opacity='1'; heroAmp.style.transform='scale(1)'; }, 450 + Math.floor(heroNameChars.length/2)*55);
    const done = 450 + heroNameChars.length*55;
    const loc = document.querySelector('.hero-loc');
    if (loc) setTimeout(() => { loc.style.opacity='1'; loc.style.transform='none'; }, done + 100);
    const cd = document.querySelector('.hero-countdown');
    if (cd) setTimeout(() => { cd.style.opacity='1'; cd.style.transform='none'; }, done + 350);          // 5. countdown slides up
    const cta = document.querySelector('.hero-cta');
    if (cta) setTimeout(() => { cta.style.opacity='1'; cta.style.transform='none'; }, done + 650);        // 6. buttons last
  }

  // ---- Timeline vertical line reveal ----
  const timelineEl = document.querySelector('.timeline');
  if (timelineEl){
    const lineIO = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting){ timelineEl.classList.add('line-in'); lineIO.disconnect(); } });
    }, { threshold: 0.05 });
    lineIO.observe(timelineEl);
  }

  // ---- Button ripple ----
  document.querySelectorAll('.btn, .btn-rsvp').forEach(btn => {
    btn.addEventListener('click', function(e){
      const rect = this.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      const r = document.createElement('span');
      r.className = 'ripple';
      r.style.width = r.style.height = size + 'px';
      r.style.left = (e.clientX - rect.left - size/2) + 'px';
      r.style.top = (e.clientY - rect.top - size/2) + 'px';
      this.appendChild(r);
      setTimeout(() => r.remove(), 650);
    });
  });

  // ---- Lenis smooth scrolling (Apple-like) ----
  let lenis = null;
  if (typeof Lenis !== 'undefined' && !reduceMotion){
    lenis = new Lenis({ duration:1.15, easing:(t)=>Math.min(1,1.001-Math.pow(2,-10*t)), smoothWheel:true, smoothTouch:false });
    window._lenis = lenis;
    (function raf(time){ lenis.raf(time); requestAnimationFrame(raf); })();
    lenis.on('scroll', onScroll);
    if (document.getElementById('opening')) lenis.stop(); // paused until the invitation is opened
  }
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href');
      if (href.length > 1){
        const target = document.querySelector(href);
        if (target){ e.preventDefault(); lenis ? lenis.scrollTo(target, { offset:-72 }) : target.scrollIntoView({ behavior:'smooth' }); }
      }
    });
  });

  // ---- RSVP form -> WhatsApp ----
  const form = document.getElementById('rsvp-form');
  const success = document.getElementById('rsvp-success');
  const WA_NUMBER = '<%= s.rsvpWa %>';
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    <% if (preview) { %>
    alert('This is a preview — the RSVP form starts working the moment your invitation is published.');
    return;
    <% } %>
    const name = document.getElementById('name').value.trim();
    const phone = document.getElementById('phone').value.trim();
    if (!name || !phone){
      alert('Please share your name and phone number so we can confirm your seat.');
      return;
    }
    const guests = document.getElementById('guests').value;
    const diet = document.getElementById('diet').value.trim();
    const message = document.getElementById('message').value.trim();
    const lines = [
      'Hello <%= s.groom %> and <%= s.bride %>,', '', 'Here is my RSVP:', '',
      'Name: ' + name,
      'Number of Guests: ' + guests,
      'Phone Number: ' + phone,
      'Meal Preference: ' + (diet || '—'),
      'Message: ' + (message || '—'),
      '', 'Thank you.'
    ];
    const url = 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(lines.join('\n'));
    window.open(url, '_blank');
    form.style.display = 'none';
    success.classList.add('show');
    success.scrollIntoView({ behavior:'smooth', block:'center' });
  });
</script>
</body>
</html>
