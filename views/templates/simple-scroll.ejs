<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/public/icons/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
<title><%= s.groom %> &amp; <%= s.bride %> · <%= s.dateShort %></title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root{--cream:#F6F3ED;--forest:#1A2C25;--gold:#C8A24B;--gold-deep:#9E7B2F;--ink:#13251F;--muted:#6D736E;
    --serif:'Cormorant Garamond',Georgia,serif;--sans:'Montserrat',sans-serif;--ease:cubic-bezier(.16,1,.3,1)}
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:var(--serif);background:var(--cream);color:var(--muted);line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  .rev{opacity:0;transform:translateY(36px);transition:opacity 1.1s var(--ease),transform 1.1s var(--ease)}
  .rev.in{opacity:1;transform:none}
  header{min-height:92vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:60px 22px;
    background:radial-gradient(900px 420px at 50% -8%, rgba(200,162,75,.18), transparent 62%), var(--cream)}
  .mono{width:88px;height:88px;border-radius:50%;border:1.5px solid var(--gold);display:flex;align-items:center;justify-content:center;
    font-style:italic;font-size:1.7rem;color:var(--gold-deep);margin-bottom:30px}
  .pre{font-family:var(--sans);font-size:.68rem;letter-spacing:.4em;text-transform:uppercase;color:var(--gold-deep);font-weight:600;margin-bottom:24px}
  h1{font-weight:300;color:var(--ink);text-transform:uppercase;letter-spacing:.1em;line-height:1.12;font-size:clamp(2.5rem,10vw,5rem)}
  h1 .amp{display:block;font-style:italic;text-transform:none;color:var(--gold);font-size:.45em;letter-spacing:.2em;padding:.2em 0}
  .dline{width:1px;height:52px;background:linear-gradient(var(--gold),transparent);margin:34px auto}
  .date{font-family:var(--sans);font-size:.85rem;letter-spacing:.34em;text-transform:uppercase;color:var(--ink);font-weight:500}
  .venue-l{font-style:italic;font-size:1.25rem;color:var(--gold-deep);margin-top:10px}
  section{padding:90px 22px;text-align:center}
  .card{max-width:640px;margin:0 auto;background:#FDFBF6;border:1px solid rgba(200,162,75,.35);border-radius:10px;padding:52px 34px;
    box-shadow:0 30px 70px -40px rgba(26,44,37,.4)}
  .cd{display:flex;justify-content:center;gap:clamp(16px,6vw,44px);margin:10px 0 6px}
  .cd div{min-width:58px}
  .cd b{display:block;font-family:var(--serif);font-weight:300;font-size:clamp(2rem,8vw,3rem);color:var(--ink);line-height:1}
  .cd span{font-family:var(--sans);font-size:.58rem;letter-spacing:.26em;text-transform:uppercase;color:var(--gold-deep)}
  h2{font-weight:300;font-size:clamp(1.7rem,5vw,2.4rem);color:var(--ink);margin-bottom:26px}
  .meta{display:flex;flex-direction:column;gap:18px;margin:26px 0;text-align:left}
  .mrow{display:flex;gap:16px;align-items:flex-start}
  .mrow svg{flex-shrink:0;margin-top:5px}
  .mrow b{display:block;color:var(--ink);font-weight:500;font-size:1.12rem}
  .mrow span{font-size:1rem}
  .btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 30px;border-radius:2px;background:var(--gold);color:var(--forest);
    font-family:var(--sans);font-size:.72rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;text-decoration:none;transition:all .4s;box-shadow:0 12px 30px -14px rgba(158,123,47,.7)}
  .btn:hover{transform:translateY(-2px);background:#E2C97E}
  .btn.line{background:transparent;border:1.5px solid var(--gold);color:var(--gold-deep);box-shadow:none}
  footer{background:var(--forest);color:var(--cream);text-align:center;padding:70px 22px 46px}
  footer .n{font-size:clamp(1.8rem,6vw,2.6rem);font-weight:300}
  footer .n i{color:var(--gold);font-style:italic}
  footer p{font-family:var(--sans);font-size:.66rem;letter-spacing:.22em;text-transform:uppercase;opacity:.65;margin-top:10px}
  footer a{color:inherit;text-decoration:none}
</style>
</head>
<body>
<% if (preview) { %><div class="pv-ribbon" style="position:fixed;top:18px;left:-52px;z-index:9999;transform:rotate(-35deg);background:#C8A24B;color:#1A2C25;font:600 11px/1 Montserrat,sans-serif;letter-spacing:.22em;padding:11px 58px;box-shadow:0 4px 16px rgba(0,0,0,.3);pointer-events:none">PREVIEW</div>
<style>@media(max-width:640px){.pv-ribbon{top:8px;left:-58px;padding:8px 54px;font-size:9px}}</style><% } %>

<header>
  <div class="mono rev in"><%= s.gi %>&amp;<%= s.bi %></div>
  <p class="pre rev in">Together with their families</p>
  <h1 class="rev in"><%= s.groom %><span class="amp">&amp;</span><%= s.bride %></h1>
  <div class="dline rev in"></div>
  <p class="date rev in"><%= s.dDots %></p>
  <p class="venue-l rev in"><%= s.venueName %></p>
</header>

<section style="padding-top:20px">
  <div class="card rev">
    <p class="pre">Counting down</p>
    <div class="cd">
      <div><b id="cd-d">0</b><span>Days</span></div>
      <div><b id="cd-h">0</b><span>Hours</span></div>
      <div><b id="cd-m">0</b><span>Minutes</span></div>
      <div><b id="cd-s">0</b><span>Seconds</span></div>
    </div>
  </div>
</section>

<section style="padding-top:10px">
  <div class="card rev" style="text-align:left">
    <h2 style="text-align:center">The details</h2>
    <div class="meta">
      <div class="mrow"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8A24B" stroke-width="1.4"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
        <div><b><%= s.dateLong %></b><span>Ceremony begins at <%= s.timeDisplay %><% if (s.arriveDisplay) { %> · kindly arrive by <%= s.arriveDisplay %><% } %></span></div></div>
      <div class="mrow"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8A24B" stroke-width="1.4"><path d="M12 22s7-5.6 7-12a7 7 0 1 0-14 0c0 6.4 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <div><b><%= s.venueName %></b><span><%= s.venueAddress %></span></div></div>
      <% if (s.rsvpByDisplay) { %>
      <div class="mrow"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8A24B" stroke-width="1.4"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>
        <div><b>RSVP by <%= s.rsvpByDisplay %></b><span>We'd love to know you're coming.</span></div></div>
      <% } %>
    </div>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:26px">
      <% if (s.rsvpWa && preview) { %><a class="btn" href="#" onclick="alert('This is a preview — RSVP starts working the moment your invitation is published.');return false">RSVP on WhatsApp</a>
      <% } else if (s.rsvpWa) { %><a class="btn" href="https://wa.me/<%= s.rsvpWa %>?text=<%= encodeURIComponent('Hello ' + s.groom + ' and ' + s.bride + '! We would love to celebrate with you. — RSVP') %>" target="_blank" rel="noopener">RSVP on WhatsApp</a><% } %>
      <a class="btn line" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(s.mapQuery) %>" target="_blank" rel="noopener">Directions</a>
    </div>
  </div>
</section>

<footer>
  <div class="n"><%= s.groom %> <i>&amp;</i> <%= s.bride %></div>
  <p><%= s.dDots %> · <%= s.venueName %></p>
  <p style="margin-top:26px"><a href="<%= brandBase %>" target="_blank" rel="noopener">Crafted on Poruwe — create yours free</a></p>
</footer>

<script>
  const T = new Date('<%= s.countdownISO %>').getTime();
  const el = { d: document.getElementById('cd-d'), h: document.getElementById('cd-h'), m: document.getElementById('cd-m'), s: document.getElementById('cd-s') };
  (function tick(){
    const df = Math.max(0, T - Date.now());
    el.d.textContent = Math.floor(df / 864e5);
    el.h.textContent = Math.floor(df % 864e5 / 36e5);
    el.m.textContent = Math.floor(df % 36e5 / 6e4);
    el.s.textContent = Math.floor(df % 6e4 / 1e3);
    setTimeout(tick, 1000);
  })();
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .15 });
  document.querySelectorAll('.rev:not(.in)').forEach((el) => io.observe(el));
</script>
</body>
</html>
